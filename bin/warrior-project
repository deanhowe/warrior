#!/usr/bin/env python3
"""Build a read-only project/package dossier before any Forge import.

`warrior-project dossier` discovers independent Git boundaries, prunes
dependency/build trees, and records only evidence: refs, dirt, remotes,
Composer identity, and version candidates. It never decides ownership from a
directory name and never creates, wires, commits, publishes, or pushes.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
from pathlib import Path
from typing import Any, Iterable

_LIB = Path(__file__).resolve().parent.parent / "lib"
if str(_LIB) not in sys.path:
    sys.path.insert(0, str(_LIB))

from warrior_forge import ConfigError, git, redact_url_userinfo, safe_output_path  # noqa: E402


PRUNED_DIRECTORIES = {
    ".git", ".hg", ".svn", "vendor", "node_modules", "Pods", "target",
    "dist", "build", ".build", ".venv", "venv", "site-packages",
}
AGENT_STATE_NAMES = {
    ".ai", ".claude", ".codex", ".docs", ".goals", ".kiro", ".knowledge",
}
PACKAGE_NAME = re.compile(r"^[a-z0-9_.-]+/[a-z0-9_.-]+$")
VERSION = re.compile(r"^v?\d+(?:\.\d+){1,3}(?:[-+][0-9A-Za-z.-]+)?$")
SENSITIVE_PATH = re.compile(
    r"(?:^|/)(?:\.tax|\.aws|\.gnupg|\.ssh|Keychains|credentials|secrets)(?:/|$)"
    r"|(?:^|[._-])(?:credential|secret|token|password|private[-_]?key|id_rsa|id_ed25519)(?:[._-]|$)"
    r"|(?:^|/)\.env(?:[./_-]|$)",
    re.IGNORECASE,
)


def discover_repositories(roots: Iterable[Path], max_depth: int) -> list[Path]:
    found: set[Path] = set()
    for supplied_root in roots:
        root = supplied_root.expanduser().resolve()
        if not root.is_dir():
            raise ValueError(f"not a directory: {root}")
        for current, directories, _files in os.walk(root, followlinks=False):
            here = Path(current)
            depth = len(here.relative_to(root).parts)
            if depth > max_depth:
                directories[:] = []
                continue
            if ".git" in directories or (here / ".git").is_file():
                found.add(here)
            directories[:] = sorted(
                name for name in directories
                if name not in PRUNED_DIRECTORIES
            )
    return sorted(found, key=lambda item: str(item).casefold())


def git_value(repo: Path, *arguments: str, strip_output: bool = True) -> str:
    code, output, _error = git(repo, *arguments, strip_output=strip_output)
    return output if code == 0 else ""


def remotes(repo: Path) -> list[dict[str, str]]:
    records: list[dict[str, str]] = []
    for line in git_value(repo, "remote", "-v").splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        records.append({
            "name": parts[0],
            "url": redact_url_userinfo(parts[1]),
            "direction": parts[2].strip("()"),
        })
    return records


def repository_role(repo: Path) -> str:
    return "auxiliary-agent-state" if AGENT_STATE_NAMES.intersection(repo.parts) else "source"


def composer_repositories(value: Any) -> list[dict[str, str]]:
    entries: list[Any]
    if isinstance(value, list):
        entries = value
    elif isinstance(value, dict):
        entries = list(value.values())
    else:
        return []

    result: list[dict[str, str]] = []
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        repository_type = str(entry.get("type", "unknown"))
        url = entry.get("url")
        result.append({
            "type": repository_type,
            "url": redact_url_userinfo(str(url)) if url else "",
        })
    return result


def composer_record(repo: Path) -> dict[str, Any] | None:
    manifest_path = repo / "composer.json"
    if not manifest_path.is_file():
        return None
    try:
        working_manifest = json.loads(manifest_path.read_text())
    except (OSError, ValueError):
        working_manifest = None
    committed_raw = git_value(repo, "cat-file", "blob", "HEAD:composer.json")
    if not committed_raw:
        return {
            "valid_json": False,
            "publishable": False,
            "blockers": ["no-committed-composer-manifest"],
            "working_tree": working_manifest,
            "working_tree_differs_from_head": True,
        }
    try:
        manifest = json.loads(committed_raw)
    except ValueError as error:
        return {
            "valid_json": False,
            "publishable": False,
            "blockers": ["invalid-committed-composer-json"],
            "error": str(error),
            "working_tree": working_manifest,
            "working_tree_differs_from_head": True,
        }
    if not isinstance(manifest, dict):
        return {
            "valid_json": False,
            "publishable": False,
            "blockers": ["composer-json-is-not-an-object"],
        }

    name = manifest.get("name") if isinstance(manifest.get("name"), str) else ""
    package_type = manifest.get("type") if isinstance(manifest.get("type"), str) else "library"
    declared = manifest.get("version") if isinstance(manifest.get("version"), str) else ""
    working_tree = None
    if isinstance(working_manifest, dict):
        working_tree = {
            "name": working_manifest.get("name") if isinstance(working_manifest.get("name"), str) else "",
            "type": working_manifest.get("type") if isinstance(working_manifest.get("type"), str) else "library",
            "declared_version": working_manifest.get("version") if isinstance(working_manifest.get("version"), str) else None,
        }
    tags_at_head = [
        tag for tag in git_value(
            repo, "for-each-ref", "--points-at=HEAD", "--format=%(refname:short)", "refs/tags"
        ).splitlines()
        if VERSION.fullmatch(tag)
    ]
    tagged_releases: list[dict[str, str]] = []
    historical_package_identities: list[dict[str, str]] = []
    for ref in git_value(
        repo,
        "for-each-ref",
        "--sort=-version:refname",
        "--format=%(refname)",
        "refs/tags",
    ).splitlines():
        version = ref.removeprefix("refs/tags/")
        if VERSION.fullmatch(version):
            try:
                tagged_manifest = json.loads(git_value(repo, "cat-file", "blob", f"{ref}:composer.json"))
            except (TypeError, ValueError):
                tagged_manifest = {}
            tagged_name = tagged_manifest.get("name") if isinstance(tagged_manifest, dict) else None
            release = {"version": version, "ref": ref}
            if tagged_name == name:
                tagged_releases.append(release)
            elif isinstance(tagged_name, str) and PACKAGE_NAME.fullmatch(tagged_name):
                historical_package_identities.append({"name": tagged_name, **release})
    versions: list[str] = []
    if declared and VERSION.fullmatch(declared):
        versions.append(declared)
    versions.extend(
        release["version"]
        for release in tagged_releases
        if release["version"] not in versions
    )

    blockers: list[str] = []
    if not PACKAGE_NAME.fullmatch(name):
        blockers.append("invalid-or-placeholder-package-name")
    if package_type in {"project", "metapackage"}:
        blockers.append(f"composer-type-{package_type}")
    if not versions:
        blockers.append("no-evidence-backed-version")
    if not git_value(repo, "rev-parse", "HEAD"):
        blockers.append("repository-has-no-commit")

    return {
        "valid_json": True,
        "name": name,
        "type": package_type,
        "declared_version": declared or None,
        "working_tree": working_tree,
        "working_tree_differs_from_head": working_manifest != manifest,
        "tags_at_head": tags_at_head,
        "tagged_releases": tagged_releases,
        "historical_package_identities": historical_package_identities,
        "version_candidates": versions,
        "repositories": composer_repositories(manifest.get("repositories")),
        "publishable": not blockers,
        "blockers": blockers,
    }


def inspect(repo: Path) -> dict[str, Any]:
    status = git_value(
        repo, "status", "--porcelain=v1", "-z", "--no-renames",
        strip_output=False,
    )
    entries = [entry for entry in status.split("\0") if entry]
    staged = sum(1 for entry in entries if len(entry) >= 2 and entry[0] not in {" ", "?"})
    modified = sum(1 for entry in entries if len(entry) >= 2 and entry[1] != " ")
    untracked = sum(1 for entry in entries if entry.startswith("??"))
    roots = git_value(repo, "rev-list", "--max-parents=0", "--all").splitlines()
    return {
        "path": str(repo),
        "role_hint": repository_role(repo),
        "branch": git_value(repo, "branch", "--show-current") or None,
        "head": git_value(repo, "rev-parse", "HEAD") or None,
        "root_commits": roots,
        "dirty": bool(entries),
        "dirty_counts": {
            "staged": staged,
            "modified": modified,
            "untracked": untracked,
        },
        "remotes": remotes(repo),
        "composer": composer_record(repo),
    }


def build_dossier(roots: list[Path], max_depth: int) -> dict[str, Any]:
    repositories = discover_repositories(roots, max_depth)
    inspected = [inspect(repo) for repo in repositories]
    package_paths: dict[str, list[str]] = {}
    for repository in inspected:
        package = repository["composer"]
        if package and package.get("valid_json") and package.get("name"):
            package_paths.setdefault(package["name"], []).append(repository["path"])
    conflicts = [
        {"name": name, "paths": sorted(paths)}
        for name, paths in sorted(package_paths.items())
        if len(paths) > 1
    ]
    return {
        "schema": 2,
        "read_only": True,
        "roots": [str(root.expanduser().resolve()) for root in roots],
        "repositories_discovered": len(repositories),
        "package_identity_conflicts": conflicts,
        "repositories": inspected,
    }


def status_entries(repo: Path) -> tuple[str, list[tuple[str, str]]]:
    code, raw, _error = git(
        repo, "status", "--porcelain=v1", "-z", "--no-renames",
        strip_output=False,
    )
    if code != 0:
        raise ValueError(f"could not read Git status for {repo}")
    entries: list[tuple[str, str]] = []
    for entry in raw.split("\0"):
        if len(entry) < 4:
            continue
        entries.append((entry[:2], entry[3:]))
    return raw, entries


def checkpoint_record(
    repository: dict[str, Any],
    identity_conflict: bool = False,
) -> dict[str, Any]:
    repo = Path(repository["path"])
    raw, entries = status_entries(repo)
    counts = {
        "staged": 0,
        "modified": 0,
        "deleted": 0,
        "untracked": 0,
        "sensitive_withheld": 0,
    }
    visible_changes: list[dict[str, str]] = []
    required: set[str] = set()
    for status, path in entries:
        sensitive = bool(SENSITIVE_PATH.search(path))
        if sensitive:
            counts["sensitive_withheld"] += 1
        else:
            visible_changes.append({"status": status, "path": path})
        if status == "??":
            counts["untracked"] += 1
            required.add("untracked-content-manifest")
            continue
        if status[0] not in {" ", "?"}:
            counts["staged"] += 1
            required.add("staged-index-patch")
        if "D" in status:
            counts["deleted"] += 1
        elif status[1] != " ":
            counts["modified"] += 1
            required.add("tracked-worktree-patch")

    checkpoint_status = "not-needed"
    if entries:
        checkpoint_status = "blocked" if counts["sensitive_withheld"] else "needed"
    package = repository["composer"]
    if package is None:
        package_status = "not-a-package"
    elif identity_conflict or not package.get("publishable"):
        package_status = "blocked"
    else:
        package_status = "publishable"

    issues: list[str] = []
    if entries:
        issues.append("dirty-working-tree")
    if counts["sensitive_withheld"]:
        issues.append("sensitive-paths-withheld")
    if not repository["head"]:
        issues.append("repository-has-no-commit")
    if identity_conflict:
        issues.append("duplicate-package-identity")
    if package:
        issues.extend(f"composer:{blocker}" for blocker in package.get("blockers", []))

    if checkpoint_status == "blocked" or package_status == "blocked" or not repository["head"]:
        verdict = "human-review-required"
    elif checkpoint_status == "needed":
        verdict = "checkpoint-needed"
    else:
        verdict = "ready"
    return {
        "path": repository["path"],
        "role_hint": repository["role_hint"],
        "branch": repository["branch"],
        "head": repository["head"],
        "root_commits": repository["root_commits"],
        "status_digest": hashlib.sha256(raw.encode()).hexdigest(),
        "checkpoint_status": checkpoint_status,
        "package_status": package_status,
        "verdict": verdict,
        "issues": issues,
        "change_counts": counts,
        "visible_changes": visible_changes,
        "required_artifacts": [
            artifact for artifact in (
                "staged-index-patch",
                "tracked-worktree-patch",
                "untracked-content-manifest",
            )
            if artifact in required
        ],
        "warnings": (["sensitive path names withheld; human review required"]
                     if counts["sensitive_withheld"] else []),
        "composer": package,
    }


def build_checkpoint_plan(roots: list[Path], max_depth: int) -> dict[str, Any]:
    dossier = build_dossier(roots, max_depth)
    conflicted_paths = {
        path
        for conflict in dossier["package_identity_conflicts"]
        for path in conflict["paths"]
    }
    repositories = [
        checkpoint_record(repository, repository["path"] in conflicted_paths)
        for repository in dossier["repositories"]
    ]
    summary = {
        "repositories": len(repositories),
        "checkpoint_needed": sum(item["checkpoint_status"] == "needed" for item in repositories),
        "human_review_required": sum(item["verdict"] == "human-review-required" for item in repositories),
        "checkpoint_not_needed": sum(item["checkpoint_status"] == "not-needed" for item in repositories),
    }
    return {
        "schema": 1,
        "read_only": True,
        "roots": dossier["roots"],
        "prerequisite": "run warrior-scan on the same roots before applying any checkpoint",
        "package_identity_conflicts": dossier["package_identity_conflicts"],
        "summary": summary,
        "repositories": repositories,
    }


def human(report: dict[str, Any]) -> str:
    lines = [
        "Warrior project dossier — read-only",
        f"Repositories: {report['repositories_discovered']}",
    ]
    for repo in report["repositories"]:
        package = repo["composer"]
        label = package.get("name") if package else "(no Composer package)"
        state = "publishable" if package and package.get("publishable") else "review"
        lines.append(f"  {repo['path']} — {label} — {state}")
    return "\n".join(lines)


def human_checkpoint_plan(report: dict[str, Any]) -> str:
    summary = report["summary"]
    lines = [
        "Warrior checkpoint plan — read-only",
        f"Repositories: {summary['repositories']}",
        f"Checkpoint needed: {summary['checkpoint_needed']}",
        f"Human review required: {summary['human_review_required']}",
        f"No checkpoint needed: {summary['checkpoint_not_needed']}",
    ]
    for repository in report["repositories"]:
        lines.append(f"  {repository['path']} — {repository['verdict']}")
    return "\n".join(lines)


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(prog="warrior-project", description=__doc__)
    subcommands = command.add_subparsers(dest="command", required=True)
    dossier = subcommands.add_parser("dossier", help="build a read-only Git and package dossier")
    dossier.add_argument("roots", nargs="+")
    dossier.add_argument("--max-depth", type=int, default=7)
    dossier.add_argument("--json", action="store_true")
    checkpoint = subcommands.add_parser(
        "checkpoint-plan",
        help="build a read-only, state-pinned checkpoint closure plan",
    )
    checkpoint.add_argument("roots", nargs="+")
    checkpoint.add_argument("--max-depth", type=int, default=7)
    checkpoint.add_argument("--json", action="store_true")
    checkpoint.add_argument("--output", type=Path, help="write the JSON report safely")
    checkpoint.add_argument("--overwrite", action="store_true",
                            help="allow --output to replace an existing report")
    return command


def main() -> int:
    arguments = parser().parse_args()
    try:
        destination = (
            safe_output_path(arguments.output, overwrite=arguments.overwrite)
            if arguments.command == "checkpoint-plan" and arguments.output
            else None
        )
        roots = [Path(root) for root in arguments.roots]
        report = (
            build_dossier(roots, arguments.max_depth)
            if arguments.command == "dossier"
            else build_checkpoint_plan(roots, arguments.max_depth)
        )
    except (ConfigError, ValueError) as error:
        print(f"warrior-project: {error}", file=sys.stderr)
        return 2
    if destination:
        destination.write_text(json.dumps(report, indent=2) + "\n")
    if arguments.json:
        print(json.dumps(report, indent=2))
    else:
        print(human(report) if arguments.command == "dossier" else human_checkpoint_plan(report))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
