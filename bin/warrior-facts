#!/usr/bin/env python3
"""warrior-facts: answer questions about this developer's machine, read-only.

This is the tool an agent calls to orient itself on an unfamiliar machine.
It answers six questions and nothing else:

    where <name>     where is the project/repo called <name>?
    repos            what repositories exist under these roots?
    repo [path]      what is this repository? (branch, HEAD, remotes, dirt)
    toolchains       what languages, runtimes and package managers are here?
    services         what is listening on this machine right now?
    unprotected      which repositories have nowhere else to live?
    orient           a small bundle of all of the above, for a cold start

Two output modes: human text by default, `--json` for machines. The JSON
shape is a stable contract, printed by `warrior-facts schema`, and is kept
deliberately small so a whole answer fits in a context window.

SAFETY CONTRACT -- this file only ever reads.

  * Every Git call passes through one guarded choke point (`git()`) that
    refuses any subcommand outside a read-only allowlist. It cannot push,
    reset, clean, prune, gc, checkout, stash, commit, or rewrite anything.
  * The bare `git stash` form is NOT a listing command -- it takes work out
    of the working tree and reports only "ok stashed". `git branch` and
    `git worktree` list when bare; `git stash` does not. GUARD_REQUIRE_VERB
    exists for exactly that trap. Do not relax it.
  * Every Git call passes `--no-optional-locks -c core.fsmonitor=`. Without
    the first, `git status` refreshes and WRITES BACK `.git/index` and runs
    the repository's post-index-change hook. Without the second, `git status`
    executes the repository-configured fsmonitor program. Either one would
    make this tool neither read-only nor safe against a repository that
    supplies its own programs.
  * No file contents are ever read. Project detection is existence checks on
    directory entries only. Directories that hold credentials (`.ssh`,
    `.gnupg`, `.aws`, `.kube`, ...) are pruned from traversal entirely and
    never opened.
  * Symlinked directories are recorded but never followed, so a walk can
    never leave the root it was given.
  * Remote URLs are printed with any embedded userinfo replaced by
    [REDACTED], so inspection can never emit a credential.
  * Version probes execute a tool only when it resolves outside the working
    tree. A repository that ships `node_modules/.bin/<anything>` on PATH does
    not get run by this tool; its path is reported and it is skipped.

The one thing this tool knows that `git status` does not: a remote protects
COMMITTED OBJECTS ONLY. Shelves, index state, stashes, untracked files and
dangling objects have zero protection from any mirror anywhere. Where that
matters, the answer says so.
"""

from __future__ import annotations

import argparse
from collections import Counter
from concurrent.futures import ThreadPoolExecutor
import datetime as dt
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Iterator

SCHEMA_VERSION = 1
TOOL_NAME = "warrior-facts"

# Exit codes, part of the contract.
EXIT_OK = 0
EXIT_NOT_FOUND = 1  # the question was valid, the answer is "nothing"
EXIT_USAGE = 2

# ---------------------------------------------------------------------------
# Traversal policy
# ---------------------------------------------------------------------------

# Dependency, build and cache output. Real work is not stored here, and
# walking it is where a machine scan goes from seconds to minutes.
PRUNE_NAMES = {
    ".build", ".bundle", ".cache", ".cargo", ".git", ".gradle", ".mypy_cache",
    ".next", ".npm", ".nuxt", ".parcel-cache", ".pnpm-store", ".pytest_cache",
    ".ruff_cache", ".swiftpm", ".terraform", ".tox", ".venv", ".yarn",
    "DerivedData", "Pods", "__pycache__", "bower_components", "build",
    "coverage", "dist", "node_modules", "target", "vendor", "venv",
}

# Never traversed, never opened, never listed. These hold credentials.
SENSITIVE_NAMES = {
    ".aws", ".azure", ".chef", ".docker", ".gnupg", ".kube", ".netrc",
    ".password-store", ".pki", ".ssh", ".subversion", "Keychains",
    "credentials", "gcloud", "secrets",
}

# Existence of any of these says "a human works here".
PROJECT_MARKERS = (
    "AGENTS.md", "CLAUDE.md", "Cargo.toml", "Dockerfile", "Gemfile",
    "Makefile", "Package.swift", "README.md", "build.gradle", "composer.json",
    "docker-compose.yaml", "docker-compose.yml", "go.mod", "package.json",
    "pyproject.toml", "requirements.txt",
)

# Where developers keep work. Home itself is never a default root: it is too
# large to walk and too full of things that are not projects.
DEFAULT_ROOT_NAMES = (
    "PROJECTS", "Projects", "projects", "Developer", "Sites", "src", "code",
    "Code", "dev", "repos", "workspace", "work", "git",
)

# ---------------------------------------------------------------------------
# The Git choke point
# ---------------------------------------------------------------------------

READ_ONLY_GIT = {
    "branch", "config", "count-objects", "for-each-ref", "log", "remote",
    "rev-parse", "stash", "status", "worktree",
}

# Subcommands whose bare form is safe but whose verbs are not (`remote add`,
# `remote remove`, `remote prune`, `config --unset`...). Require an explicit
# read-only option and refuse every verb.
GUARD_NO_VERB = {
    "remote": {"-v", "--verbose"},
    "status": {"--porcelain", "--porcelain=v1", "--porcelain=v2", "-z",
               "--no-renames", "--branch", "--untracked-files=all",
               "--untracked-files=normal", "--ignored=no"},
    "count-objects": {"-v", "--verbose"},
}

# Subcommands whose bare form performs an action or is ambiguous. The first
# verb must be one of these, and there must be exactly one.
GUARD_REQUIRE_VERB = {
    "stash": {"list"},
    "worktree": {"list"},
}

# Subcommands that must carry at least one of these read-only options.
GUARD_REQUIRE_OPTION = {
    "branch": {"--show-current", "--list", "--format", "-a", "--all", "-v"},
    "config": {"--get", "--get-all", "--get-regexp", "--list"},
}

# Refused wherever they appear, in any position, in any subcommand.
DENY_TOKENS = {
    "--all-but", "--delete", "--force", "--hard", "--merge", "--mixed",
    "--prune", "--set-upstream", "--set-upstream-to", "--soft", "--unset",
    "--unset-all", "--write", "-D", "-d", "-f", "-u",
}

GIT_TIMEOUT = 30

URL_USERINFO = re.compile(r"([a-z][a-z0-9+.-]*://)[^/@\s]+@", re.IGNORECASE)


def redact_remote(line: str) -> str:
    """Remove URL userinfo so inspection cannot print embedded credentials."""
    return URL_USERINFO.sub(r"\1[REDACTED]@", line)


def assert_read_only(args: tuple[str, ...]) -> None:
    """Refuse anything that is not a proven read-only Git form."""
    if not args:
        raise RuntimeError("refusing to invoke git with no subcommand")
    subcommand = args[0]
    if subcommand not in READ_ONLY_GIT:
        raise RuntimeError(f"refusing non-read-only git subcommand: {subcommand}")
    rest = args[1:]
    verbs = [token for token in rest if not token.startswith("-")]
    options = [token for token in rest if token.startswith("-")]

    for token in rest:
        if token in DENY_TOKENS:
            raise RuntimeError(f"refusing git {subcommand} with denied token: {token}")

    if subcommand in GUARD_NO_VERB:
        if verbs:
            raise RuntimeError(f"refusing git {subcommand} with verb: {verbs[0]}")
        if not options:
            raise RuntimeError(f"refusing bare git subcommand: {subcommand}")
        unknown = [token for token in options if token not in GUARD_NO_VERB[subcommand]]
        if unknown:
            raise RuntimeError(f"refusing git {subcommand} with options: {unknown}")

    if subcommand in GUARD_REQUIRE_VERB:
        allowed = GUARD_REQUIRE_VERB[subcommand]
        if not verbs:
            raise RuntimeError(f"refusing bare git subcommand: {subcommand}")
        if verbs[0] not in allowed:
            raise RuntimeError(f"refusing ambiguous git form: {subcommand} {verbs[0]}")
        if len(verbs) > 1:
            raise RuntimeError(f"refusing git {subcommand} with extra verb: {verbs[1]}")

    if subcommand in GUARD_REQUIRE_OPTION:
        if not set(options) & GUARD_REQUIRE_OPTION[subcommand]:
            raise RuntimeError(f"refusing git {subcommand} without a read-only option")


def git(repo: Path, *args: str, timeout: int = GIT_TIMEOUT) -> tuple[int, str, str]:
    """The one and only Git subprocess. Guarded, read-only, never prompts."""
    assert_read_only(args)
    env = dict(os.environ)
    # Never let Git prompt for anything, and never let it reach a network.
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["GIT_ASKPASS"] = ""
    env["GIT_OPTIONAL_LOCKS"] = "0"
    try:
        process = subprocess.run(
            # --no-optional-locks: without it `git status` refreshes and writes
            # back .git/index, and runs the repo's post-index-change hook.
            # -c core.fsmonitor=: without it `git status` executes the
            # repository-configured fsmonitor program.
            ["git", "--no-optional-locks", "-c", "core.fsmonitor=",
             "-C", str(repo), *args],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=False,
            timeout=timeout,
            env=env,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return -1, "", f"{type(error).__name__}: {str(error)[:200]}"
    return process.returncode, process.stdout, process.stderr.strip()[:200]


def out(result: tuple[int, str, str]) -> str:
    return result[1].strip()


# ---------------------------------------------------------------------------
# Bounded, symlink-safe traversal
# ---------------------------------------------------------------------------


def walk_dirs(
    root: Path,
    max_depth: int,
    stats: Counter,
    prune: set[str] | None = None,
) -> Iterator[tuple[Path, int, set[str], set[str], list[str]]]:
    """Yield (path, depth, child_dir_names, file_names, live_dirs) under root.

    Never follows symlinks, so a walk cannot leave the root it was given.
    Child directory names are yielded BEFORE pruning, so callers can still
    see `.git` without the walk descending into it. `live_dirs` is os.walk's
    own mutable list: a caller that clears it stops descent from that
    directory, which is how a bare repository's object store is skipped.
    """
    prune = PRUNE_NAMES if prune is None else prune

    def onerror(_error: OSError) -> None:
        stats["unreadable"] += 1

    for current, dirs, files in os.walk(root, topdown=True, followlinks=False, onerror=onerror):
        path = Path(current)
        try:
            depth = len(path.relative_to(root).parts)
        except ValueError:  # pragma: no cover - os.walk stays inside root
            dirs[:] = []
            continue
        raw_dirs = set(dirs)
        yield path, depth, raw_dirs, set(files), dirs
        kept = []
        for name in sorted(dirs, key=str.casefold):
            child = path / name
            if name in SENSITIVE_NAMES:
                stats["sensitive"] += 1
            elif name in prune:
                stats["noisy"] += 1
            elif depth + 1 > max_depth:
                stats["depth_limit"] += 1
            elif child.is_symlink():
                stats["symlink"] += 1
            else:
                kept.append(name)
        dirs[:] = kept


def repo_kind(path: Path, dir_names: set[str], file_names: set[str]) -> str | None:
    """Classify a directory as a Git boundary, or None."""
    if ".git" in dir_names:
        return "git_worktree"
    if ".git" in file_names:
        return "git_linked_worktree"
    if "HEAD" in file_names and "objects" in dir_names and "refs" in dir_names:
        return "bare_git"
    return None


def markers_for(file_names: set[str], dir_names: set[str]) -> list[str]:
    present = file_names | dir_names
    return [marker for marker in PROJECT_MARKERS if marker in present]


# ---------------------------------------------------------------------------
# Roots
# ---------------------------------------------------------------------------


def default_roots() -> list[Path]:
    """Where this developer probably keeps work, discovered not assumed."""
    from_env = os.environ.get("WARRIOR_ROOTS", "").strip()
    if from_env:
        candidates = [Path(item).expanduser() for item in from_env.split(os.pathsep) if item]
    else:
        home = Path.home()
        candidates = [home / name for name in DEFAULT_ROOT_NAMES]
        go_src = home / "go" / "src"
        if go_src.is_dir():
            candidates.append(go_src)
    roots = [path for path in candidates if path.is_dir()]
    cwd = Path.cwd()
    if not any(is_within(cwd, root) for root in roots):
        roots.append(cwd)
    return dedupe_roots(roots)


def is_within(path: Path, root: Path) -> bool:
    try:
        path.resolve().relative_to(root.resolve())
        return True
    except (ValueError, OSError):
        return False


def dedupe_roots(roots: list[Path]) -> list[Path]:
    """Resolve, drop duplicates, drop any root contained in another root."""
    resolved: list[Path] = []
    for root in roots:
        try:
            candidate = root.expanduser().resolve()
        except OSError:
            continue
        if not candidate.is_dir():
            continue
        if candidate not in resolved:
            resolved.append(candidate)
    kept = []
    for candidate in resolved:
        if any(candidate != other and is_within(candidate, other) for other in resolved):
            continue
        kept.append(candidate)
    return sorted(kept, key=lambda item: str(item).casefold())


def resolve_roots(supplied: list[str] | None) -> tuple[list[Path], list[str]]:
    warnings: list[str] = []
    if not supplied:
        roots = default_roots()
        if not roots:
            warnings.append("No project roots found. Pass --root explicitly.")
        return roots, warnings
    roots = []
    for item in supplied:
        path = Path(item).expanduser()
        if not path.is_dir():
            warnings.append(f"Not a directory, skipped: {path}")
            continue
        roots.append(path)
    return dedupe_roots(roots), warnings


# ---------------------------------------------------------------------------
# where: find a project or repository by name
# ---------------------------------------------------------------------------


def normalize(value: str) -> str:
    return re.sub(r"[^a-z0-9]", "", value.casefold())


def match_score(query: str, name: str, relative: str) -> tuple[int, str] | None:
    """Rank a directory against a query. Higher is better, None is no match."""
    if "/" in query:
        wanted = query.strip("/").casefold()
        have = relative.casefold()
        if have == wanted:
            return 100, "path_exact"
        if have.endswith("/" + wanted):
            return 90, "path_suffix"
        if wanted in have:
            return 55, "path_substring"
        return None
    lowered = query.casefold()
    if name == query:
        return 100, "exact"
    if name.casefold() == lowered:
        return 95, "exact_icase"
    if normalize(name) == normalize(query):
        return 85, "exact_normalized"
    if name.casefold().startswith(lowered):
        return 70, "prefix"
    if lowered in name.casefold():
        return 50, "substring"
    if normalize(query) and normalize(query) in normalize(name):
        return 40, "substring_normalized"
    return None


def find_where(
    query: str, roots: list[Path], max_depth: int, limit: int,
) -> tuple[dict[str, Any], bool]:
    stats: Counter = Counter()
    hits: list[dict[str, Any]] = []
    for root in roots:
        for path, depth, dir_names, file_names, live_dirs in walk_dirs(root, max_depth, stats):
            if path == root:
                continue
            if repo_kind(path, dir_names, file_names) == "bare_git":
                live_dirs.clear()
            relative = path.relative_to(root).as_posix()
            scored = match_score(query, path.name, relative)
            if scored is None:
                continue
            score, how = scored
            kind = repo_kind(path, dir_names, file_names)
            hits.append({
                "path": str(path),
                "name": path.name,
                "root": str(root),
                "relative": relative,
                "depth": depth,
                "match": how,
                "score": score,
                "is_repo": kind is not None,
                "repo_kind": kind,
                "markers": markers_for(file_names, dir_names),
            })
    hits.sort(key=lambda item: (-item["score"], item["depth"], item["path"].casefold()))
    total = len(hits)
    truncated = bool(limit) and total > limit
    if truncated:
        hits = hits[:limit]
    return {
        "query": query,
        "roots": [str(root) for root in roots],
        "max_depth": max_depth,
        "count": total,
        "matches": hits,
        "excluded_from_traversal": dict(sorted(stats.items())),
    }, truncated


# ---------------------------------------------------------------------------
# repos / unprotected: what repositories exist, and which have no home
# ---------------------------------------------------------------------------


def discover_repositories(roots: list[Path], max_depth: int) -> tuple[list[dict[str, Any]], Counter]:
    stats: Counter = Counter()
    found: list[dict[str, Any]] = []
    seen: set[str] = set()
    for root in roots:
        for path, depth, dir_names, file_names, live_dirs in walk_dirs(root, max_depth, stats):
            kind = repo_kind(path, dir_names, file_names)
            if kind is None:
                continue
            if kind == "bare_git":
                # Never walk an object store: 256 fan-out directories of
                # nothing a human ever edits.
                live_dirs.clear()
            key = str(path)
            if key in seen:
                continue
            seen.add(key)
            found.append({
                "path": key,
                "name": path.name,
                "root": str(root),
                "relative": path.relative_to(root).as_posix() or ".",
                "depth": depth,
                "kind": kind,
            })
    found.sort(key=lambda item: item["path"].casefold())
    return found, stats


def remote_transport(url: str) -> str:
    value = url.strip()
    if value.startswith(("ssh://", "git+ssh://")):
        return "ssh"
    if value.startswith(("https://", "http://")):
        return "https"
    if value.startswith("git://"):
        return "git"
    if value.startswith(("file://", "/", "./", "../", "~")):
        return "file"
    if re.match(r"^[^/@\s]+@[^:/\s]+:", value):
        return "ssh"
    return "unknown"


def read_remotes(repo: Path) -> list[dict[str, str]]:
    """Remote name, redacted URL and transport. Never prints a credential."""
    code, stdout, _ = git(repo, "remote", "-v")
    if code != 0:
        return []
    seen: dict[tuple[str, str], dict[str, str]] = {}
    for line in stdout.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        name, url = parts[0], parts[1]
        key = (name, url)
        if key in seen:
            continue
        seen[key] = {
            "name": name,
            "url": redact_remote(url),
            "transport": remote_transport(url),
        }
    return list(seen.values())


def protection_for(remotes: list[dict[str, str]]) -> tuple[bool, str]:
    """Is this repository's history stored anywhere but this disk?

    A filesystem-path remote is not protection: it is the same disk, and a
    filesystem push into an already-up-to-date repository exits 0 having sent
    nothing, so it looks like it worked when it did not.
    """
    if not remotes:
        return False, "no_remote"
    transports = {remote["transport"] for remote in remotes}
    if transports <= {"file", "unknown"}:
        return False, "local_path_remote_only"
    return True, "has_network_remote"


def annotate_protection(records: list[dict[str, Any]], workers: int) -> None:
    def annotate(record: dict[str, Any]) -> None:
        remotes = read_remotes(Path(record["path"]))
        protected, reason = protection_for(remotes)
        record["remote_names"] = [remote["name"] for remote in remotes]
        record["transports"] = sorted({remote["transport"] for remote in remotes})
        record["protected"] = protected
        record["protection"] = reason

    if not records:
        return
    with ThreadPoolExecutor(max_workers=max(1, workers)) as pool:
        list(pool.map(annotate, records))


def survey_repositories(
    roots: list[Path], max_depth: int, limit: int, workers: int, with_git: bool,
    only_unprotected: bool = False,
) -> tuple[dict[str, Any], bool]:
    records, stats = discover_repositories(roots, max_depth)
    scanned = len(records)
    if with_git:
        annotate_protection(records, workers)
    if only_unprotected:
        records = [item for item in records if item.get("protected") is False]
    total = len(records)
    unprotected = sum(1 for item in records if item.get("protected") is False)
    truncated = bool(limit) and total > limit
    shown = records[:limit] if truncated else records
    result = {
        "roots": [str(root) for root in roots],
        "max_depth": max_depth,
        "scanned": scanned,
        "count": total,
        "unprotected_count": unprotected if with_git else None,
        "kinds": dict(sorted(Counter(item["kind"] for item in records).items())),
        "repositories": shown,
        "excluded_from_traversal": dict(sorted(stats.items())),
    }
    return result, truncated


# ---------------------------------------------------------------------------
# repo: what is this repository
# ---------------------------------------------------------------------------


def enclosing_repo(start: Path) -> Path | None:
    """Walk up for a Git boundary without asking Git to resolve it for us."""
    current = start.expanduser().resolve()
    for candidate in [current, *current.parents]:
        marker = candidate / ".git"
        if marker.is_dir() or marker.is_file():
            return candidate
        if (candidate / "HEAD").is_file() and (candidate / "objects").is_dir():
            return candidate
    return None


def parse_status_counts(payload: str) -> dict[str, int]:
    """Count `status --porcelain=v1 -z --no-renames` entries.

    --no-renames is deliberate: without it a rename entry carries a second
    NUL-separated path, and a naive split counts that source path as another
    change. Asking Git not to detect renames removes the trap entirely.
    """
    counts = {"staged": 0, "modified": 0, "untracked": 0}
    for entry in payload.split("\0"):
        if len(entry) < 3:
            continue
        index_state, worktree_state = entry[0], entry[1]
        if index_state == "?" and worktree_state == "?":
            counts["untracked"] += 1
            continue
        if index_state not in {" ", "?", "!"}:
            counts["staged"] += 1
        if worktree_state not in {" ", "?", "!"}:
            counts["modified"] += 1
    return counts


def nested_repositories(top: Path, max_depth: int = 4) -> list[str]:
    stats: Counter = Counter()
    nested = []
    for path, _depth, dir_names, file_names, live_dirs in walk_dirs(top, max_depth, stats):
        if path == top:
            continue
        kind = repo_kind(path, dir_names, file_names)
        if kind is not None:
            nested.append(str(path))
            if kind == "bare_git":
                live_dirs.clear()
    return sorted(nested)


def worktrees_for(repo: Path) -> list[str]:
    code, stdout, _ = git(repo, "worktree", "list", "--porcelain")
    if code != 0:
        return []
    return [line.split(" ", 1)[1] for line in stdout.splitlines() if line.startswith("worktree ")]


def inspect_repository(target: Path, nested_depth: int = 4) -> dict[str, Any] | None:
    repo = enclosing_repo(target)
    if repo is None:
        return None
    head = out(git(repo, "rev-parse", "--short=12", "HEAD"))
    branch = out(git(repo, "branch", "--show-current"))
    upstream_code, upstream_raw, _ = git(repo, "rev-parse", "--abbrev-ref", "@{upstream}")
    upstream = upstream_raw.strip() if upstream_code == 0 else None
    _, status_raw, _ = git(repo, "status", "--porcelain=v1", "-z", "--no-renames")
    counts = parse_status_counts(status_raw)
    stash_code, stash_raw, _ = git(repo, "stash", "list")
    stash_entries = len([line for line in stash_raw.splitlines() if line.strip()]) if stash_code == 0 else 0
    remotes = read_remotes(repo)
    protected, reason = protection_for(remotes)
    last_commit = out(git(repo, "log", "-1", "--format=%cI|%an|%s"))
    commit: dict[str, str] | None = None
    if "|" in last_commit:
        when, author, subject = last_commit.split("|", 2)
        commit = {"date": when, "author": author, "subject": subject[:120]}
    is_bare = out(git(repo, "rev-parse", "--is-bare-repository")) == "true"
    nested = nested_repositories(repo, nested_depth) if not is_bare else []
    worktrees = worktrees_for(repo)

    unprotected_work = counts["untracked"] + counts["modified"] + counts["staged"] + stash_entries
    advice: list[str] = []
    if not protected and reason == "no_remote":
        advice.append("This repository has no remote. Its entire history exists on this disk only.")
    if not protected and reason == "local_path_remote_only":
        advice.append(
            "Every remote is a filesystem path. That is the same disk, and a filesystem "
            "push into an up-to-date repository exits 0 having sent nothing."
        )
    if protected and unprotected_work:
        advice.append(
            f"A remote protects committed objects only. {unprotected_work} uncommitted, "
            "untracked or stashed items here have no protection anywhere."
        )
    if stash_entries:
        advice.append(
            f"{stash_entries} stash entr{'y' if stash_entries == 1 else 'ies'} exist. "
            "Stashes are invisible to `git status` and are never mirrored."
        )
    if not branch:
        advice.append("HEAD is detached. Commits made here are unreachable from any branch.")
    if len(worktrees) > 1:
        advice.append(f"{len(worktrees)} worktrees share this repository's object store.")
    if nested:
        advice.append(
            f"{len(nested)} nested repositor{'y' if len(nested) == 1 else 'ies'} exist below this one. "
            "The outer repository's status says nothing about them."
        )

    return {
        "path": str(repo),
        "name": repo.name,
        "bare": is_bare,
        "branch": branch or None,
        "detached": not branch,
        "head": head or None,
        "upstream": upstream,
        "last_commit": commit,
        "counts": counts,
        "stash_entries": stash_entries,
        "clean": unprotected_work == 0,
        "remotes": remotes,
        "protected": protected,
        "protection": reason,
        "worktrees": worktrees,
        "nested_repositories": nested,
        "advice": advice,
    }


