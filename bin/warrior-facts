    ("terraform", "infra", ("--version",)),
    ("git", "vcs", ("--version",)),
    ("gh", "vcs", ("--version",)),
    ("hg", "vcs", ("--version",)),
    ("svn", "vcs", ("--version",)),
)

VERSION_TIMEOUT = 6


def trusted_executable(resolved: Path) -> bool:
    """Refuse to execute a tool that resolves inside the working tree.

    A repository that ships `node_modules/.bin/<name>` and asks you to put it
    on PATH gets its path reported by this tool and nothing else.
    """
    cwd = Path.cwd().resolve()
    try:
        resolved.resolve().relative_to(cwd)
        return False
    except (ValueError, OSError):
        return True


def probe_tool(entry: tuple[str, str, tuple[str, ...]], with_versions: bool) -> dict[str, Any] | None:
    name, category, version_args = entry
    location = shutil.which(name)
    if not location:
        return None
    resolved = Path(location)
    record: dict[str, Any] = {
        "name": name,
        "category": category,
        "path": str(resolved),
        "version": None,
    }
    if not with_versions:
        record["version_note"] = "not probed (--no-versions)"
        return record
    if not trusted_executable(resolved):
        record["version_note"] = "not executed: resolves inside the working tree"
        return record
    try:
        process = subprocess.run(
            [str(resolved), *version_args],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=False,
            timeout=VERSION_TIMEOUT,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        record["version_note"] = f"probe failed: {type(error).__name__}"
        return record
    text = (process.stdout or "") + "\n" + (process.stderr or "")
    for line in text.splitlines():
        if line.strip():
            record["version"] = line.strip()[:120]
            break
    return record


def survey_toolchains(with_versions: bool = True, workers: int = 8) -> dict[str, Any]:
    with ThreadPoolExecutor(max_workers=max(1, workers)) as pool:
        results = list(pool.map(lambda entry: probe_tool(entry, with_versions), TOOLS))
    found = [record for record in results if record]
    found.sort(key=lambda item: (item["category"], item["name"]))
    by_category: dict[str, list[str]] = {}
    for record in found:
        by_category.setdefault(record["category"], []).append(record["name"])
    return {
        "count": len(found),
        "by_category": {key: by_category[key] for key in sorted(by_category)},
        "tools": found,
        "missing": sorted({name for name, _, _ in TOOLS} - {item["name"] for item in found}),
    }


# ---------------------------------------------------------------------------
# services: what is listening right now
# ---------------------------------------------------------------------------

PORT_HINTS = {
    80: "http", 443: "https", 1025: "smtp (mailpit/mailhog)", 2222: "ssh (alt)",
    3000: "node/rails dev server", 3001: "node dev server", 3306: "mysql",
    4200: "angular dev server", 5000: "flask/airplay", 5173: "vite dev server",
    5432: "postgresql", 5354: "dns (alt port)", 6379: "redis",
    7000: "airplay", 8000: "http dev server", 8025: "mailpit web ui",
    8080: "http alt", 8443: "https alt", 8501: "streamlit", 9000: "php-fpm",
    9200: "elasticsearch", 11211: "memcached", 27017: "mongodb",
    5601: "kibana", 15672: "rabbitmq ui",
}

LOOPBACK = {"127.0.0.1", "::1", "[::1]", "localhost"}
WILDCARD = {"*", "0.0.0.0", "::", "[::]"}


def parse_lsof(payload: str) -> list[dict[str, Any]]:
    rows = []
    for line in payload.splitlines()[1:]:
        tokens = line.split()
        if len(tokens) < 9:
            continue
        name = tokens[-2] if tokens[-1] == "(LISTEN)" else tokens[-1]
        if ":" not in name:
            continue
        address, _, port = name.rpartition(":")
        if not port.isdigit():
            continue
        rows.append({
            "process": tokens[0],
            "pid": tokens[1],
            "family": tokens[4] if len(tokens) > 4 else "",
            "address": address or "*",
            "port": int(port),
        })
    return rows


def parse_ss(payload: str) -> list[dict[str, Any]]:
    rows = []
    for line in payload.splitlines():
        tokens = line.split()
        if len(tokens) < 4:
            continue
        local = tokens[3]
        if ":" not in local:
            continue
        address, _, port = local.rpartition(":")
        if not port.isdigit():
            continue
        process = ""
        pid = ""
        match = re.search(r'users:\(\("([^"]+)",pid=(\d+)', line)
        if match:
            process, pid = match.group(1), match.group(2)
        rows.append({
            "process": process or "unknown",
            "pid": pid,
            "family": "IPv6" if address.startswith("[") else "IPv4",
            "address": address or "*",
            "port": int(port),
        })
    return rows


def listening_rows() -> tuple[list[dict[str, Any]], str, list[str]]:
    """List listening TCP sockets. Listing only -- nothing is ever connected to."""
    warnings: list[str] = []
    attempts: list[tuple[str, list[str], Any]] = [
        ("lsof", ["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"], parse_lsof),
        ("ss", ["ss", "-H", "-ltnp"], parse_ss),
        ("netstat", ["netstat", "-ltnp"], parse_ss),
    ]
    for label, command, parser in attempts:
        if not shutil.which(command[0]):
            continue
        try:
            process = subprocess.run(
                command,
                stdin=subprocess.DEVNULL,
                capture_output=True,
                text=True,
                check=False,
                timeout=20,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            warnings.append(f"{label} probe failed: {type(error).__name__}")
            continue
        rows = parser(process.stdout)
        if rows or process.returncode == 0:
            if label in {"lsof", "netstat"}:
                warnings.append(
                    f"Listing shows processes visible to {os.environ.get('USER', 'this user')} only; "
                    "sockets owned by other users are not shown."
                )
            return rows, label, warnings
    warnings.append("No socket listing tool found (lsof, ss, netstat).")
    return [], "none", warnings


def survey_services() -> tuple[dict[str, Any], list[str]]:
    rows, source, warnings = listening_rows()
    grouped: dict[tuple[int, str], dict[str, Any]] = {}
    for row in rows:
        key = (row["port"], row["process"])
        record = grouped.setdefault(key, {
            "port": row["port"],
            "process": row["process"],
            "pids": set(),
            "addresses": set(),
        })
        if row["pid"]:
            record["pids"].add(row["pid"])
        record["addresses"].add(row["address"])
    services = []
    for record in grouped.values():
        addresses = record["addresses"]
        if addresses & WILDCARD:
            scope = "all_interfaces"
        elif addresses <= LOOPBACK:
            scope = "loopback"
        else:
            scope = "specific_interface"
        services.append({
            "port": record["port"],
            "process": record["process"],
            "pids": sorted(record["pids"]),
            "addresses": sorted(addresses),
            "scope": scope,
            "hint": PORT_HINTS.get(record["port"]),
        })
    services.sort(key=lambda item: (item["port"], item["process"]))
    return {
        "source": source,
        "protocol": "tcp",
        "count": len(services),
        "exposed_beyond_loopback": sum(1 for item in services if item["scope"] != "loopback"),
        "services": services,
    }, warnings


# ---------------------------------------------------------------------------
# orient: the cold-start bundle
# ---------------------------------------------------------------------------


def orient(roots: list[Path], max_depth: int, workers: int, limit: int) -> tuple[dict[str, Any], list[str]]:
    warnings: list[str] = []
    repos, stats = discover_repositories(roots, max_depth)
    annotate_protection(repos, workers)
    unprotected = [item for item in repos if item.get("protected") is False]
    toolchains = survey_toolchains(with_versions=False, workers=workers)
    services, service_warnings = survey_services()
    warnings.extend(service_warnings)
    here = inspect_repository(Path.cwd(), nested_depth=2)
    by_root = Counter(item["root"] for item in repos)
    return {
        "host": {
            "os": platform.system(),
            "release": platform.release(),
            "machine": platform.machine(),
            "python": platform.python_version(),
            "user": os.environ.get("USER") or os.environ.get("LOGNAME") or "",
            "home": str(Path.home()),
            "cwd": str(Path.cwd()),
        },
        "roots": [
            {"path": str(root), "repositories": by_root.get(str(root), 0)}
            for root in roots
        ],
        "repositories": {
            "count": len(repos),
            "unprotected_count": len(unprotected),
            "kinds": dict(sorted(Counter(item["kind"] for item in repos).items())),
            "unprotected_sample": [item["path"] for item in unprotected[:limit or 10]],
        },
        "toolchains": toolchains["by_category"],
        "services": {
            "count": services["count"],
            "exposed_beyond_loopback": services["exposed_beyond_loopback"],
            "ports": sorted({item["port"] for item in services["services"]})[:40],
        },
        "current_repository": here,
        "excluded_from_traversal": dict(sorted(stats.items())),
    }, warnings


# ---------------------------------------------------------------------------
# Envelope and rendering
# ---------------------------------------------------------------------------


def envelope(command: str, result: Any, warnings: list[str], truncated: bool, elapsed: float) -> dict[str, Any]:
    return {
        "schema_version": SCHEMA_VERSION,
        "tool": TOOL_NAME,
        "command": command,
        "read_only": True,
        "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "elapsed_seconds": round(elapsed, 3),
        "truncated": truncated,
        "warnings": warnings,
        "result": result,
    }


SCHEMA_DOC = {
    "schema_version": SCHEMA_VERSION,
    "tool": TOOL_NAME,
    "envelope": {
        "schema_version": "int, bumped only on a breaking change",
        "tool": "always 'warrior-facts'",
        "command": "which question was asked",
        "read_only": "always true; this tool has no write path",
        "generated_at": "ISO-8601 UTC",
        "elapsed_seconds": "float",
        "truncated": "true when --limit cut the list; result.count is still the full total",
        "warnings": "list of strings; things the answer could not see",
        "result": "command-specific, described below",
    },
    "exit_codes": {
        "0": "answered",
        "1": "valid question, empty answer (no match, not a repository)",
        "2": "usage error",
    },
    "commands": {
        "where": "result: {query, roots[], max_depth, count, matches[{path,name,root,relative,depth,match,score,is_repo,repo_kind,markers[]}], excluded_from_traversal{}}",
        "repos": "result: {roots[], max_depth, scanned, count, unprotected_count, kinds{}, repositories[{path,name,root,relative,depth,kind,remote_names[],transports[],protected,protection}], excluded_from_traversal{}}",
        "unprotected": "same shape as repos, filtered to protected=false; scanned is the total examined, count the number unprotected",
        "repo": "result: {path,name,bare,branch,detached,head,upstream,last_commit,counts{staged,modified,untracked},stash_entries,clean,remotes[{name,url,transport}],protected,protection,worktrees[],nested_repositories[],advice[]}",
        "toolchains": "result: {count, by_category{}, tools[{name,category,path,version,version_note}], missing[]}",
        "services": "result: {source, protocol, count, exposed_beyond_loopback, services[{port,process,pids[],addresses[],scope,hint}]}",
        "orient": "result: {host{}, roots[], repositories{}, toolchains{}, services{}, current_repository, excluded_from_traversal{}}",
    },
    "invariants": {
        "remote_urls": "userinfo is replaced with [REDACTED] before printing",
        "protection": "protected=false when there is no remote, or when every remote is a filesystem path",
        "traversal": "symlinked directories are never followed; credential directories are never opened",
        "file_contents": "no project file is ever read; detection is existence checks only",
    },
}


def line(label: str, value: Any) -> str:
    return f"  {label:<22}{value}"


def render_where(result: dict[str, Any], truncated: bool) -> str:
    lines = []
    count = result["count"]
    if not count:
        lines.append(f'No match for "{result["query"]}" under {len(result["roots"])} root(s).')
        for root in result["roots"]:
            lines.append(f"  searched  {root}")
        lines.append("  Try a wider --max-depth, or pass --root explicitly.")
        return "\n".join(lines)
    shown = len(result["matches"])
    suffix = f" (showing {shown})" if truncated else ""
    lines.append(f'{count} match(es) for "{result["query"]}"{suffix}')
    lines.append("")
    for item in result["matches"]:
        flags = []
        if item["is_repo"]:
            flags.append(item["repo_kind"])
        if item["markers"]:
            flags.append("markers: " + ", ".join(item["markers"][:4]))
        lines.append(f"  {item['path']}")
        lines.append(f"      {item['match']:<20}{'  |  '.join(flags) if flags else 'plain directory'}")
    return "\n".join(lines)


def render_repos(result: dict[str, Any], truncated: bool, title: str) -> str:
    lines = [
        f"{title}: {result['count']} of {result['scanned']} scanned under "
        f"{len(result['roots'])} root(s), depth {result['max_depth']}"
    ]
    if result.get("unprotected_count") is not None:
        lines.append(f"  unprotected: {result['unprotected_count']}")
    if result["kinds"]:
        lines.append("  kinds: " + ", ".join(f"{key}={value}" for key, value in result["kinds"].items()))
    lines.append("")
    for item in result["repositories"]:
        mark = "  " if item.get("protected") else "! "
        detail = item.get("protection") or item["kind"]
        lines.append(f"{mark}{item['path']}")
        if item.get("protected") is not None:
            lines.append(f"      {item['kind']:<22}{detail}")
    if truncated:
        lines.append("")
        lines.append(f"  ... {result['count'] - len(result['repositories'])} more (raise --limit, or 0 for all)")
    if result["excluded_from_traversal"]:
        lines.append("")
        lines.append("  pruned: " + ", ".join(
            f"{key}={value}" for key, value in result["excluded_from_traversal"].items()))
    return "\n".join(lines)


def render_repo(result: dict[str, Any]) -> str:
    lines = [result["path"]]
    lines.append(line("branch", result["branch"] or "DETACHED"))
    lines.append(line("head", result["head"] or "(no commits)"))
    if result["upstream"]:
        lines.append(line("upstream", result["upstream"]))
    if result["last_commit"]:
        commit = result["last_commit"]
        lines.append(line("last commit", f"{commit['date']}  {commit['author']}  {commit['subject']}"))
    counts = result["counts"]
    lines.append(line(
        "working tree",
        f"staged={counts['staged']}  modified={counts['modified']}  untracked={counts['untracked']}  "
        f"stashes={result['stash_entries']}",
    ))
    if result["remotes"]:
        for remote in result["remotes"]:
            lines.append(line(f"remote {remote['name']}", f"{remote['url']}  [{remote['transport']}]"))
    else:
        lines.append(line("remotes", "none"))
    lines.append(line("protected", f"{result['protected']} ({result['protection']})"))
    if len(result["worktrees"]) > 1:
        lines.append(line("worktrees", str(len(result["worktrees"]))))
        for path in result["worktrees"]:
            lines.append(f"      {path}")
    if result["nested_repositories"]:
        lines.append(line("nested repos", str(len(result["nested_repositories"]))))
        for path in result["nested_repositories"][:10]:
            lines.append(f"      {path}")
    if result["advice"]:
        lines.append("")
        for item in result["advice"]:
            lines.append(f"  * {item}")
    return "\n".join(lines)


def render_toolchains(result: dict[str, Any]) -> str:
    lines = [f"{result['count']} tool(s) present on PATH"]
    lines.append("")
    current = None
    for tool in result["tools"]:
        if tool["category"] != current:
            current = tool["category"]
            lines.append(f"  {current}")
        version = tool["version"] or tool.get("version_note") or ""
        lines.append(f"    {tool['name']:<14}{version}")
        lines.append(f"    {'':<14}{tool['path']}")
    return "\n".join(lines)


def render_services(result: dict[str, Any]) -> str:
    lines = [
        f"{result['count']} listening TCP socket group(s) via {result['source']}; "
        f"{result['exposed_beyond_loopback']} reachable beyond loopback"
    ]
    lines.append("")
    for item in result["services"]:
        hint = f"  ({item['hint']})" if item["hint"] else ""
        lines.append(
            f"  {item['port']:<8}{item['process']:<20}{item['scope']:<20}"
            f"{','.join(item['addresses'])}{hint}"
        )
    return "\n".join(lines)


def render_orient(result: dict[str, Any]) -> str:
    host = result["host"]
    lines = [f"{host['os']} {host['release']} ({host['machine']}), user {host['user']}"]
    lines.append(line("cwd", host["cwd"]))
    lines.append("")
    lines.append("Roots")
    for root in result["roots"]:
        lines.append(f"    {root['repositories']:>5} repos   {root['path']}")
    repos = result["repositories"]
    lines.append("")
    lines.append(f"Repositories: {repos['count']} total, {repos['unprotected_count']} unprotected")
    for path in repos["unprotected_sample"]:
        lines.append(f"    ! {path}")
    lines.append("")
    lines.append("Toolchains")
    for category, names in result["toolchains"].items():
        lines.append(f"    {category:<18}{', '.join(names)}")
    services = result["services"]
    lines.append("")
    lines.append(
        f"Services: {services['count']} listening, {services['exposed_beyond_loopback']} beyond loopback"
    )
    if services["ports"]:
        lines.append("    ports: " + ", ".join(str(port) for port in services["ports"]))
    here = result["current_repository"]
    lines.append("")
    if here:
        lines.append("Current repository")
        lines.append(render_repo(here))
    else:
        lines.append("Current repository: none (cwd is not inside a Git boundary)")
    return "\n".join(lines)


RENDERERS = {
    "where": lambda result, truncated: render_where(result, truncated),
    "repos": lambda result, truncated: render_repos(result, truncated, "Repositories"),
    "unprotected": lambda result, truncated: render_repos(result, truncated, "Unprotected repositories"),
    "repo": lambda result, truncated: render_repo(result),
    "toolchains": lambda result, truncated: render_toolchains(result),
    "services": lambda result, truncated: render_services(result),
    "orient": lambda result, truncated: render_orient(result),
    "schema": lambda result, truncated: json.dumps(result, indent=2, sort_keys=True),
}


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=TOOL_NAME,
        description="Read-only answers about this developer's machine.",
        epilog="This tool never writes. Every Git call is guarded read-only.",
    )
    parser.add_argument("--json", action="store_true", help="emit the stable JSON contract")
    parser.add_argument("--root", action="append", dest="roots", metavar="PATH",
                        help="search root (repeatable; default: discovered, or $WARRIOR_ROOTS)")
    parser.add_argument("--max-depth", type=int, default=None, metavar="N",
                        help="traversal depth below each root (default: 4 for where, 3 otherwise)")
    parser.add_argument("--limit", type=int, default=None, metavar="N",
                        help="cap listed items; 0 means no cap")
    parser.add_argument("--workers", type=int, default=8, metavar="N",
                        help="parallel Git inspections (default 8)")
    parser.add_argument("--no-versions", action="store_true",
                        help="toolchains: report presence and path, do not execute anything")
    parser.add_argument("--no-git", action="store_true",
                        help="repos: skip Git inspection, list boundaries only")

    subparsers = parser.add_subparsers(dest="command", metavar="COMMAND")
    where = subparsers.add_parser("where", help="where is project/repo <name>?")
    where.add_argument("query", help="name, or a path fragment like VHOSTS/app")
    subparsers.add_parser("repos", help="what repositories exist under these roots?")
    subparsers.add_parser("unprotected", help="which repositories have no remote?")
    repo = subparsers.add_parser("repo", help="what is this repository?")
    repo.add_argument("path", nargs="?", default=".", help="path inside the repository (default: cwd)")
    subparsers.add_parser("toolchains", help="what languages and package managers are here?")
    subparsers.add_parser("services", help="what is listening on this machine?")
    subparsers.add_parser("orient", help="a cold-start bundle of everything above")
    subparsers.add_parser("schema", help="print the stable JSON contract")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    command = args.command or "orient"

    if args.max_depth is not None and not 0 <= args.max_depth <= 10:
        parser.error("--max-depth must be between 0 and 10")
    if args.limit is not None and args.limit < 0:
        parser.error("--limit must be 0 or greater")
    if args.workers < 1 or args.workers > 32:
        parser.error("--workers must be between 1 and 32")

    started = time.monotonic()
    warnings: list[str] = []
    truncated = False
    exit_code = EXIT_OK

    if command == "schema":
        result: Any = SCHEMA_DOC
    elif command == "repo":
        result = inspect_repository(Path(args.path))
        if result is None:
            target = Path(args.path).expanduser().resolve()
            result = {"path": str(target), "found": False}
            warnings.append(f"{target} is not inside a Git boundary.")
            exit_code = EXIT_NOT_FOUND
    elif command == "toolchains":
        result = survey_toolchains(with_versions=not args.no_versions, workers=args.workers)
    elif command == "services":
        result, service_warnings = survey_services()
        warnings.extend(service_warnings)
    else:
        roots, root_warnings = resolve_roots(args.roots)
        warnings.extend(root_warnings)
        if not roots:
            print("No readable search roots. Pass --root PATH.", file=sys.stderr)
            return EXIT_USAGE
        if command == "where":
            depth = args.max_depth if args.max_depth is not None else 4
            limit = args.limit if args.limit is not None else 50
            result, truncated = find_where(args.query, roots, depth, limit)
            if not result["count"]:
                exit_code = EXIT_NOT_FOUND
        elif command in {"repos", "unprotected"}:
            depth = args.max_depth if args.max_depth is not None else 3
            limit = args.limit if args.limit is not None else 100
            with_git = not args.no_git or command == "unprotected"
            result, truncated = survey_repositories(
                roots, depth, limit, args.workers, with_git,
                only_unprotected=command == "unprotected",
            )
            if not result["count"]:
                exit_code = EXIT_NOT_FOUND
        else:  # orient
            depth = args.max_depth if args.max_depth is not None else 3
            limit = args.limit if args.limit is not None else 10
            result, orient_warnings = orient(roots, depth, args.workers, limit)
            warnings.extend(orient_warnings)

    elapsed = time.monotonic() - started
    if args.json:
        payload = envelope(command, result, warnings, truncated, elapsed)
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        if isinstance(result, dict) and result.get("found") is False:
            print(f"{result['path']} is not inside a Git repository.")
        else:
            print(RENDERERS[command](result, truncated))
        for warning in warnings:
            print(f"  ! {warning}", file=sys.stderr)
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
