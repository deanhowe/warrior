#!/usr/bin/env python3
"""Assess history and build isolated rewrite candidates without changing the source."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any, Optional


ARTIFACT_SUFFIXES = {
    ".db": "database",
    ".db3": "database",
    ".sqlite": "database",
    ".sqlite3": "database",
    ".mdb": "database",
    ".accdb": "database",
    ".sql": "database-dump",
    ".dump": "database-dump",
    ".bak": "database-dump",
    ".backup": "database-dump",
    ".zip": "archive",
    ".7z": "archive",
    ".rar": "archive",
    ".tar": "archive",
    ".tgz": "archive",
    ".gz": "archive",
    ".bz2": "archive",
    ".xz": "archive",
    ".bundle": "git-bundle",
    ".jar": "package-archive",
    ".war": "package-archive",
    ".apk": "package-archive",
    ".ipa": "package-archive",
    ".dmg": "disk-image",
    ".iso": "disk-image",
    ".pkg": "installer",
    ".msi": "installer",
    ".exe": "compiled-binary",
    ".dll": "compiled-binary",
    ".dylib": "compiled-binary",
    ".so": "compiled-binary",
    ".mov": "media",
    ".mp4": "media",
    ".mkv": "media",
    ".wav": "media",
    ".aiff": "media",
    ".mp3": "media",
}
SENSITIVE_PATH_PARTS = {
    ".aws", ".gnupg", ".ssh", ".tax", "credentials", "keychains", "secrets"
}
SENSITIVE_NAME = re.compile(
    r"(?:^|[._-])(credential|secret|token|password|private[-_]?key|id_rsa|id_ed25519)"
    r"(?:[._-]|$)|^\.env",
    re.IGNORECASE,
)
SENSITIVE_SUBJECT = re.compile(
    r"\b(password|passwd|secret|token|credential|api[-_ ]?key|private key)\b",
    re.IGNORECASE,
)
APPLE_GIT = "/usr/bin/git"
SAFE_MACOS_PATH = "/usr/bin:/usr/local/bin:/opt/homebrew/bin"
PUBLIC_CONTENT_PATTERNS = {
    "github-token": re.compile(rb"\bgh[pousr]_[A-Za-z0-9_]{20,}\b"),
    "aws-access-key": re.compile(rb"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"),
    "private-key": re.compile(rb"-----BEGIN (?:[A-Z0-9 ]+ )?PRIVATE KEY-----"),
    "absolute-user-path": re.compile(
        rb"(?:/Users/[A-Za-z0-9._-]+/|/home/[A-Za-z0-9._-]+/|[A-Za-z]:\\\\Users\\\\[^\\\\\r\n]+\\\\)"
    ),
    "email-address": re.compile(
        rb"(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}(?![A-Za-z0-9.-])"
    ),
}


def assert_read_only(args: tuple[str, ...]) -> None:
    """Allow only the exact Git forms used by this assessor."""
    if not args:
        raise RuntimeError("refusing to invoke Git without a subcommand")
    command, rest = args[0], args[1:]
    allowed = {
        "rev-parse": {
            ("--is-inside-work-tree",), ("--is-bare-repository",),
            ("--abbrev-ref", "HEAD"), ("HEAD",),
        },
        "ls-files": {("-z",)},
        "ls-tree": {("-r", "--name-only", "-z", "HEAD")},
        "rev-list": {
            ("--objects", "--all"), ("--max-parents=0", "--all"),
            ("--all", "--count"),
        },
        "status": {("--porcelain=v1", "--untracked-files=all")},
        "for-each-ref": {
            ("--format=%(refname)%00%(objectname)",),
        },
        "cat-file": {("--batch-check=%(objectname) %(objecttype) %(objectsize)",)},
        "fsck": {("--unreachable", "--no-reflogs", "--no-progress")},
    }
    if command == "log":
        valid = (
            len(rest) == 3
            and rest[0] == "-1"
            and rest[1] == "--format=%H%x1f%ci%x1f%s"
            and re.fullmatch(r"[0-9a-f]{40,64}", rest[2]) is not None
        )
        if valid:
            return
    if command not in allowed or rest not in allowed[command]:
        raise RuntimeError(f"refusing unapproved Git form: git {' '.join(args)}")


def git(repo: Path, *args: str, input_text: Optional[str] = None) -> tuple[int, str, str]:
    assert_read_only(args)
    environment = dict(os.environ)
    environment.setdefault("GIT_TERMINAL_PROMPT", "0")
    try:
        process = subprocess.run(
            [APPLE_GIT, "--no-optional-locks", "-c", "core.fsmonitor=", "-C", str(repo), *args],
            input=input_text,
            capture_output=True,
            text=True,
            errors="replace",
            check=False,
            timeout=300,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return -1, "", f"{type(error).__name__}: {error}"
    return process.returncode, process.stdout, process.stderr.strip()


def artifact_kind(path: str) -> Optional[str]:
    name = path.casefold()
    for suffix, kind in ARTIFACT_SUFFIXES.items():
        if name.endswith(suffix):
            return kind
    return None


def sensitive_path(path: str) -> bool:
    candidate = Path(path)
    return (
        any(part.casefold() in SENSITIVE_PATH_PARTS for part in candidate.parts)
        or SENSITIVE_NAME.search(candidate.name) is not None
    )


def public_path(item: dict[str, Any]) -> dict[str, Any]:
    cleaned = dict(item)
    path = cleaned.pop("_path")
    if sensitive_path(path):
        cleaned["path_withheld"] = True
    else:
        cleaned["path"] = path
        cleaned["path_withheld"] = False
    return cleaned


def public_subject(subject: str) -> str:
    return "[sensitive commit subject withheld]" if SENSITIVE_SUBJECT.search(subject) else subject


def object_sizes(repo: Path, object_ids: set[str]) -> dict[str, int]:
    if not object_ids:
        return {}
    payload = "\n".join(sorted(object_ids)) + "\n"
    code, output, _ = git(
        repo,
        "cat-file",
        "--batch-check=%(objectname) %(objecttype) %(objectsize)",
        input_text=payload,
    )
    if code != 0:
        return {}
    sizes: dict[str, int] = {}
    for line in output.splitlines():
        fields = line.split()
        if len(fields) == 3 and fields[1] == "blob" and fields[2].isdigit():
            sizes[fields[0]] = int(fields[2])
    return sizes


def find_unreachable_commits(repo: Path) -> list[dict[str, str]]:
    code, output, _ = git(repo, "fsck", "--unreachable", "--no-reflogs", "--no-progress")
    if code not in {0, 1}:
        return []
    commit_ids = [
        line.split()[-1]
        for line in output.splitlines()
        if line.startswith("unreachable commit ")
    ]
    commits = []
    for commit_id in sorted(commit_ids):
        meta_code, metadata, _ = git(
            repo, "log", "-1", "--format=%H%x1f%ci%x1f%s", commit_id
        )
        if meta_code != 0:
            continue
        fields = metadata.strip().split("\x1f", 2)
        if len(fields) != 3:
            continue
        commits.append({
            "commit": fields[0],
            "date": fields[1],
            "subject": public_subject(fields[2]),
            "disposition": "preserve-and-review",
            "next_step": "Inspect it and give valuable work a named ref before Git expiry.",
        })
    return commits


def find_root_commits(repo: Path) -> list[dict[str, str]]:
    code, output, _ = git(repo, "rev-list", "--max-parents=0", "--all")
    if code != 0:
        return []
    roots = []
    for commit_id in sorted(output.splitlines()):
        meta_code, metadata, _ = git(
            repo, "log", "-1", "--format=%H%x1f%ci%x1f%s", commit_id
        )
        if meta_code != 0:
            continue
        fields = metadata.strip().split("\x1f", 2)
        if len(fields) == 3:
            roots.append({
                "commit": fields[0], "date": fields[1], "subject": public_subject(fields[2])
            })
    return roots


def assess(repo: Path, large_bytes: int = 10 * 1024 * 1024) -> dict[str, Any]:
    code, inside, error = git(repo, "rev-parse", "--is-inside-work-tree")
    bare_code, bare_output, bare_error = git(repo, "rev-parse", "--is-bare-repository")
    is_bare = bare_code == 0 and bare_output.strip() == "true"
    if (code != 0 or inside.strip() != "true") and not is_bare:
        raise ValueError(error or bare_error or f"not a Git repository: {repo}")

    _, branch, _ = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    _, head, _ = git(repo, "rev-parse", "HEAD")
    _, commit_count_output, _ = git(repo, "rev-list", "--all", "--count")
    if is_bare:
        _, tracked_output, _ = git(repo, "ls-tree", "-r", "--name-only", "-z", "HEAD")
    else:
        _, tracked_output, _ = git(repo, "ls-files", "-z")
    current_paths = {item for item in tracked_output.split("\0") if item}
    code, objects_output, error = git(repo, "rev-list", "--objects", "--all")
    if code != 0:
        raise ValueError(error or "could not enumerate reachable history")

    historical_paths: dict[tuple[str, str], dict[str, str]] = {}
    candidates: dict[tuple[str, str], dict[str, Any]] = {}
    object_ids: set[str] = set()
    for line in objects_output.splitlines():
        object_id, separator, path = line.partition(" ")
        if not separator or not path:
            continue
        object_ids.add(object_id)
        historical_paths[(path, object_id)] = {"path": path, "object": object_id}
        kind = artifact_kind(path)
        if not kind:
            continue
        candidates[(path, object_id)] = {
            "_path": path,
            "kind": kind,
            "presence": "current" if path in current_paths else "history-only",
            "object": object_id,
        }

    sizes = object_sizes(repo, object_ids)
    artifacts = []
    for item in candidates.values():
        item["size_bytes"] = sizes.get(item["object"])
        artifacts.append(public_path(item))
    artifacts.sort(key=lambda item: (item.get("path", "").casefold(), item["object"]))

    large_blobs = []
    for item in historical_paths.values():
        size = sizes.get(item["object"])
        if size is None or size < large_bytes:
            continue
        large_blobs.append(public_path({
            "_path": item["path"],
            "object": item["object"],
            "size_bytes": size,
            "presence": "current" if item["path"] in current_paths else "history-only",
        }))
    large_blobs.sort(key=lambda item: (-item["size_bytes"], item.get("path", "").casefold()))
    sensitive_paths_withheld = sum(
        1 for item in artifacts if item.get("path_withheld")
    )
    root_commits = find_root_commits(repo)
    warnings = []
    if len(root_commits) > 1:
        warnings.append("multiple unrelated root histories")
    guidance = []
    if any(item["presence"] == "history-only" for item in artifacts):
        guidance.append(
            "Removing a file in a later commit did not remove its earlier blobs; "
            "build and verify a separate rewrite candidate before changing any canonical history."
        )
    if any(item["presence"] == "current" for item in artifacts):
        guidance.append(
            "Current database, archive, media, installer, or binary files may be intentional; "
            "classify them before proposing Git LFS or a history change."
        )
    if large_blobs:
        guidance.append(
            "Large blobs affect every clone even when their paths were later removed; "
            "confirm ownership and provenance before planning a rewrite."
        )
    if len(root_commits) > 1:
        guidance.append(
            "Identify which refs own each root before combining or rewriting them; "
            "same repository name does not prove shared identity."
        )
    return {
        "repository": str(repo),
        "mode": "read-only",
        "repository_kind": "bare" if is_bare else "working-tree",
        "branch": branch.strip() or None,
        "head": head.strip() or None,
        "reachable_commit_count": (
            int(commit_count_output.strip()) if commit_count_output.strip().isdigit() else None
        ),
        "root_commits": root_commits,
        "warnings": warnings,
        "guidance": guidance,
        "artifacts": artifacts,
        "large_blob_threshold_bytes": large_bytes,
        "large_blobs": large_blobs,
        "sensitive_paths_withheld": sensitive_paths_withheld,
        "unreachable_commits": find_unreachable_commits(repo),
        "limits": [
            "filenames and object sizes are inspected; file contents are never read",
            "an artifact is a review candidate, not an automatic deletion recommendation",
        ],
    }


def source_refs(repo: Path) -> dict[str, str]:
    code, output, error = git(
        repo, "for-each-ref", "--format=%(refname)%00%(objectname)",
    )
    if code != 0:
        raise ValueError(error or "could not read source refs")
    refs: dict[str, str] = {}
    for line in output.splitlines():
        name, separator, object_id = line.partition("\0")
        if separator:
            refs[name] = object_id
    return refs


def selected_public_ref(repo: Path, value: str) -> tuple[str, str]:
    refs = source_refs(repo)
    candidates = [value] if value.startswith("refs/") else [f"refs/heads/{value}"]
    matches = [(name, refs[name]) for name in candidates if name in refs]
    if len(matches) != 1 or not matches[0][0].startswith("refs/heads/"):
        raise ValueError("--ref must name exactly one existing local branch")
    return matches[0]


def git_public_read(repo: Path, *args: str, timeout: int = 300) -> subprocess.CompletedProcess[bytes]:
    environment = dict(os.environ)
    environment.setdefault("GIT_TERMINAL_PROMPT", "0")
    return subprocess.run(
        [APPLE_GIT, "--no-optional-locks", "-c", "core.fsmonitor=", "-C", str(repo), *args],
        capture_output=True, check=False, timeout=timeout, env=environment,
    )


def reserved_example_email(value: bytes) -> bool:
    local, domain = value.lower().rsplit(b"@", 1)
    return (
        local in {b"git", b"noreply", b"codex"}
        or domain in {
            b"example.com", b"example.net", b"example.org",
            b"github.com", b"users.noreply.github.com",
        }
        or domain.endswith((b".example.com", b".example.net", b".example.org"))
        or domain.endswith((b".invalid", b".example", b".test"))
    )


def placeholder_user_path(value: bytes) -> bool:
    lowered = value.lower().replace(b"\\", b"/")
    return any(
        marker in lowered
        for marker in (
            b"/users/developer/", b"/users/example/",
            b"/home/developer/", b"/home/example/", b"/home/x/",
        )
    )


def publishable_matches(category: str, data: bytes, allowed: set[bytes]) -> list[re.Match[bytes]]:
    matches = list(PUBLIC_CONTENT_PATTERNS[category].finditer(data))
    if category == "email-address":
        return [
            match for match in matches
            if match.group(0).lower() not in allowed
            and not reserved_example_email(match.group(0))
        ]
    if category == "absolute-user-path":
        return [match for match in matches if not placeholder_user_path(match.group(0))]
    return matches


def public_audit(repo: Path, selected_ref: str, allowed_emails: list[str]) -> dict[str, Any]:
    repo = repo.expanduser().resolve()
    refname, ref_object = selected_public_ref(repo, selected_ref)
    allowed = {value.casefold().encode() for value in allowed_emails}
    objects = git_public_read(repo, "rev-list", "--objects", refname)
    if objects.returncode != 0:
        raise ValueError("could not enumerate the selected public history")

    findings: dict[str, int] = {category: 0 for category in PUBLIC_CONTENT_PATTERNS}
    finding_locations: list[dict[str, Any]] = []
    seen_blobs: set[str] = set()
    for raw_line in objects.stdout.splitlines():
        object_id, separator, raw_path = raw_line.partition(b" ")
        if not separator or not raw_path:
            continue
        object_text = object_id.decode("ascii", "ignore")
        if object_text in seen_blobs:
            continue
        blob = git_public_read(repo, "cat-file", "blob", object_text)
        if blob.returncode != 0:
            continue
        seen_blobs.add(object_text)
        path = raw_path.decode("utf-8", "replace")
        for category in PUBLIC_CONTENT_PATTERNS:
            matches = publishable_matches(category, blob.stdout, allowed)
            if not matches:
                continue
            findings[category] += len(matches)
            location: dict[str, Any] = {"category": category, "object": object_text}
            if sensitive_path(path):
                location["path_withheld"] = True
            else:
                location["path"] = path
                location["path_withheld"] = False
            finding_locations.append(location)

    messages = git_public_read(repo, "log", "--format=%B%x00", refname)
    if messages.returncode != 0:
        raise ValueError("could not inspect selected commit messages")
    message_findings: dict[str, int] = {}
    for category in PUBLIC_CONTENT_PATTERNS:
        message_findings[category] = len(
            publishable_matches(category, messages.stdout, allowed)
        )

    metadata = git_public_read(repo, "log", "--format=%ae%x00%ce", refname)
    if metadata.returncode != 0:
        raise ValueError("could not inspect selected commit metadata")
    metadata_emails = {
        field.strip().lower()
        for line in metadata.stdout.splitlines()
        for field in line.split(b"\x00")
        if field.strip()
    }
    unapproved_metadata = metadata_emails - allowed
    count = git_public_read(repo, "rev-list", "--count", refname)
    commit_count = int(count.stdout.strip()) if count.returncode == 0 else None
    safe = (
        not any(findings.values())
        and not any(message_findings.values())
        and not unapproved_metadata
    )
    return {
        "mode": "read-only-public-history-audit",
        "repository": str(repo),
        "selected_ref": refname,
        "selected_object": ref_object,
        "scanned_ref_count": 1,
        "reachable_commit_count": commit_count,
        "content_blob_count": len(seen_blobs),
        "findings_by_category": findings,
        "commit_message_findings_by_category": message_findings,
        "finding_locations": finding_locations,
        "commit_metadata_email_count": len(metadata_emails),
        "unapproved_commit_email_count": len(unapproved_metadata),
        "allowed_email_count": len(allowed),
        "safe_for_publication": safe,
        "limits": [
            "heuristic secret detection reduces risk but cannot prove that arbitrary prose is non-sensitive",
            "matched values and commit email addresses are never printed",
            "only the explicitly selected branch was scanned",
        ],
    }


def validate_removal_path(value: str) -> str:
    path = Path(value)
    if not value or path.is_absolute() or ".." in path.parts or ".git" in path.parts:
        raise ValueError(f"remove paths must be safe repository-relative paths: {value!r}")
    return path.as_posix()


def source_history_paths(repo: Path) -> set[str]:
    code, output, error = git(repo, "rev-list", "--objects", "--all")
    if code != 0:
        raise ValueError(error or "could not enumerate source history")
    return {
        line.partition(" ")[2]
        for line in output.splitlines()
        if line.partition(" ")[1]
    }


def assert_clean_source(repo: Path) -> None:
    code, output, error = git(repo, "status", "--porcelain=v1", "--untracked-files=all")
    if code != 0:
        raise ValueError(error or "could not inspect source working tree")
    if output:
        raise ValueError("source working tree is not clean; candidate would omit uncommitted work")


def safe_plan_output(path: Path) -> Path:
    resolved = path.expanduser().resolve()
    if resolved.suffix != ".json" or resolved.name.startswith("."):
        raise ValueError("rewrite plan output must be a visible .json file")
    if not resolved.parent.is_dir():
        raise ValueError("rewrite plan parent directory does not exist")
    if ".git" in resolved.parts:
        raise ValueError("refusing to write a rewrite plan inside Git metadata")
    if resolved.exists():
        raise ValueError("rewrite plan output already exists; refusing to overwrite it")
    return resolved


def create_rewrite_plan(repo: Path, remove_paths: list[str], output: Path) -> dict[str, Any]:
    repo = repo.expanduser().resolve()
    repository = assess(repo, large_bytes=10 * 1024 * 1024)
    if repository["repository_kind"] != "working-tree":
        raise ValueError("rewrite planning currently requires a working-tree repository")
    assert_clean_source(repo)
    paths = sorted({validate_removal_path(item) for item in remove_paths})
    if not paths:
        raise ValueError("at least one --remove-path is required")
    historical = source_history_paths(repo)
    missing = [
        path for path in paths
        if not any(candidate == path or candidate.startswith(path.rstrip("/") + "/") for candidate in historical)
    ]
    if missing:
        raise ValueError("one or more remove paths do not exist in reachable source history")
    plan = {
        "schema_version": 1,
        "operation": "remove-paths-from-candidate-history",
        "source_repository": str(repo),
        "source_head": repository["head"],
        "source_refs": source_refs(repo),
        "remove_paths": paths,
        "safety": {
            "source_is_never_rewritten": True,
            "destination_must_not_exist": True,
            "candidate_requires_verification": True,
        },
    }
    destination = safe_plan_output(output)
    if repo == destination or repo in destination.parents:
        raise ValueError("rewrite plan output must be outside the source repository")
    destination.write_text(json.dumps(plan, indent=2, sort_keys=True) + "\n")
    return plan


def validate_public_email(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+", value):
        raise ValueError("--public-email must be one syntactically safe email address")
    return value


def validate_public_name(value: str) -> str:
    if not value.strip() or value != value.strip() or len(value) > 100:
        raise ValueError("--public-name must be a non-empty trimmed name")
    if any(ord(character) < 32 or ord(character) == 127 for character in value):
        raise ValueError("--public-name must not contain control characters")
    return value


def create_public_plan(
    repo: Path,
    selected_ref: str,
    public_name: str,
    public_email: str,
    coauthor_policy: str,
    remove_paths: list[str],
    replace_text: Optional[Path],
    output: Path,
) -> dict[str, Any]:
    if coauthor_policy not in {"strip", "retain"}:
        raise ValueError("public planning requires an explicit co-author policy")
    repo = repo.expanduser().resolve()
    repository = assess(repo, large_bytes=10 * 1024 * 1024)
    if repository["repository_kind"] != "working-tree":
        raise ValueError("public planning requires a working-tree repository")
    assert_clean_source(repo)
    refname, ref_object = selected_public_ref(repo, selected_ref)
    paths = sorted({validate_removal_path(item) for item in remove_paths})
    if paths:
        objects = git_public_read(repo, "rev-list", "--objects", refname)
        historical = {
            line.partition(b" ")[2].decode("utf-8", "replace")
            for line in objects.stdout.splitlines() if b" " in line
        }
        missing = [
            path for path in paths
            if not any(item == path or item.startswith(path.rstrip("/") + "/") for item in historical)
        ]
        if missing:
            raise ValueError("one or more remove paths do not exist in selected history")
    replacement_record = None
    if replace_text is not None:
        replacement = replace_text.expanduser().resolve()
        if not replacement.is_file():
            raise ValueError("--replace-text must be an existing regular file")
        if replacement == repo or repo in replacement.parents:
            raise ValueError("private replacement rules must be outside the source repository")
        replacement_record = {
            "path": str(replacement),
            "sha256": hashlib.sha256(replacement.read_bytes()).hexdigest(),
        }
    plan = {
        "schema_version": 2,
        "operation": "build-public-projection-candidate",
        "source_repository": str(repo),
        "source_head": repository["head"],
        "source_refs": source_refs(repo),
        "selected_ref": refname,
        "selected_object": ref_object,
        "public_name": validate_public_name(public_name),
        "public_email": validate_public_email(public_email),
        "coauthor_policy": coauthor_policy,
        "remove_paths": paths,
        "replacement_rules": replacement_record,
        "safety": {
            "source_is_never_rewritten": True,
            "only_selected_branch_is_exported": True,
            "destination_must_not_exist": True,
            "candidate_must_pass_public_audit": True,
        },
    }
    destination = safe_plan_output(output)
    if destination == repo or repo in destination.parents:
        raise ValueError("public plan output must be outside the source repository")
    destination.write_text(json.dumps(plan, indent=2, sort_keys=True) + "\n")
    return plan


def run_process(
    args: list[str], timeout: int = 300, cwd: Optional[Path] = None
) -> subprocess.CompletedProcess[str]:
    environment = dict(os.environ)
    environment.setdefault("GIT_TERMINAL_PROMPT", "0")
    environment["PATH"] = SAFE_MACOS_PATH
    return subprocess.run(
        args, capture_output=True, text=True, errors="replace", check=False,
        timeout=timeout, env=environment, cwd=str(cwd) if cwd else None,
    )


def load_rewrite_plan(path: Path) -> dict[str, Any]:
    try:
        plan = json.loads(path.expanduser().read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"could not read rewrite plan: {error}") from error
    if plan.get("schema_version") != 1 or plan.get("operation") != "remove-paths-from-candidate-history":
        raise ValueError("unsupported rewrite plan")
    return plan


def load_public_plan(path: Path) -> dict[str, Any]:
    try:
        plan = json.loads(path.expanduser().read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"could not read public plan: {error}") from error
    if plan.get("schema_version") != 2 or plan.get("operation") != "build-public-projection-candidate":
        raise ValueError("unsupported public projection plan")
    if plan.get("coauthor_policy") not in {"strip", "retain"}:
        raise ValueError("public projection plan has no explicit co-author policy; regenerate it")
    return plan


def build_public_candidate(plan_path: Path, destination: Path) -> dict[str, Any]:
    plan = load_public_plan(plan_path)
    source = Path(plan["source_repository"]).expanduser().resolve()
    destination = destination.expanduser().resolve()
    if destination.exists():
        raise ValueError("candidate destination already exists; refusing to overwrite it")
    if not destination.parent.is_dir():
        raise ValueError("candidate parent directory does not exist")
    if ".git" in destination.parts or destination == source or source in destination.parents:
        raise ValueError("candidate destination must be outside source and Git metadata")
    assert_clean_source(source)
    if git(source, "rev-parse", "HEAD")[1].strip() != plan.get("source_head"):
        raise ValueError("source HEAD changed after the public plan was created")
    if source_refs(source) != plan.get("source_refs"):
        raise ValueError("source refs changed after the public plan was created")
    refname, ref_object = selected_public_ref(source, plan["selected_ref"])
    if ref_object != plan.get("selected_object"):
        raise ValueError("selected source ref changed after the public plan was created")
    replacement = None
    if plan.get("replacement_rules"):
        replacement = Path(plan["replacement_rules"]["path"]).expanduser().resolve()
        if not replacement.is_file():
            raise ValueError("private replacement rules are no longer available")
        digest = hashlib.sha256(replacement.read_bytes()).hexdigest()
        if digest != plan["replacement_rules"]["sha256"]:
            raise ValueError("private replacement rules changed after planning")
    filter_repo = shutil.which("git-filter-repo")
    if not filter_repo:
        raise ValueError("git-filter-repo is required (install it with Homebrew)")
    filter_entrypoint = Path(filter_repo)
    if filter_entrypoint.parent not in {Path("/usr/local/bin"), Path("/opt/homebrew/bin")}:
        raise ValueError("git-filter-repo must be installed in a Homebrew binary directory")
    branch = refname.removeprefix("refs/heads/")
    cloned = run_process([
        APPLE_GIT, "clone", "--bare", "--single-branch", "--branch", branch,
        "--no-tags", "--no-local", "--", str(source), str(destination),
    ])
    if cloned.returncode != 0:
        raise ValueError(f"public candidate clone failed; preserved partial destination: {cloned.stderr.strip()}")
    disconnected = run_process([APPLE_GIT, "--git-dir", str(destination), "remote", "remove", "origin"])
    if disconnected.returncode != 0:
        raise ValueError("public candidate could not be disconnected; preserved for inspection")
    email = validate_public_email(plan["public_email"])
    name = validate_public_name(plan["public_name"])
    callback = (
        f"commit.author_name = {name.encode()!r}\n"
        f"commit.committer_name = {name.encode()!r}\n"
        f"commit.author_email = {email.encode()!r}\n"
        f"commit.committer_email = {email.encode()!r}"
    )
    if plan["coauthor_policy"] == "strip":
        callback += (
            "\ncommit.message = b'\\n'.join("
            "line for line in commit.message.split(b'\\n') "
            "if not line.lower().startswith(b'co-authored-by:'))"
            "\ncommit.message = commit.message.split("
            "b'\\\\n\\\\nCo-Authored-By:', 1)[0]"
        )
    filter_args = [filter_repo, "--force", "--commit-callback", callback]
    for path in plan["remove_paths"]:
        filter_args.extend(["--path", validate_removal_path(path)])
    if plan["remove_paths"]:
        filter_args.append("--invert-paths")
    if replacement is not None:
        filter_args.extend([
            "--replace-text", str(replacement),
            "--replace-message", str(replacement),
        ])
    rewritten = run_process(filter_args, timeout=900, cwd=destination)
    if rewritten.returncode != 0:
        raise ValueError("public candidate rewrite failed; candidate preserved for inspection")
    candidate_refs = source_refs(destination)
    checked = run_process([APPLE_GIT, "--git-dir", str(destination), "fsck", "--full"])
    remotes = run_process([APPLE_GIT, "--git-dir", str(destination), "remote"])
    audit = public_audit(destination, branch, [email])
    identity = git_public_read(destination, "log", "--format=%an%x00%cn%x00", refname)
    messages = git_public_read(destination, "log", "--format=%B", refname)
    expected_name = name.encode()
    identity_parts = (
        [part.strip() for part in identity.stdout.split(b"\x00") if part.strip()]
        if identity.returncode == 0 else []
    )
    names_match = bool(identity_parts) and all(part == expected_name for part in identity_parts)
    no_coauthors = (
        messages.returncode == 0
        and b"co-authored-by:" not in messages.stdout.lower()
    )
    verification = {
        "source_unchanged": (
            git(source, "rev-parse", "HEAD")[1].strip() == plan["source_head"]
            and source_refs(source) == plan["source_refs"]
        ),
        "selected_branch_only": set(candidate_refs) == {refname},
        "candidate_fsck_passed": checked.returncode == 0,
        "candidate_has_no_remotes": remotes.returncode == 0 and not remotes.stdout.strip(),
        "public_audit_passed": audit["safe_for_publication"],
        "public_owner_identity": names_match,
        "coauthor_policy_applied": (
            no_coauthors if plan["coauthor_policy"] == "strip" else True
        ),
    }
    if not all(verification.values()):
        failed = ", ".join(name for name, passed in verification.items() if not passed)
        raise ValueError(
            f"public candidate verification failed ({failed}); candidate preserved for inspection"
        )
    return {
        "mode": "public-projection-candidate",
        "source_repository": str(source),
        "candidate_repository": str(destination),
        "selected_ref": refname,
        "verification": verification,
        "public_audit": audit,
        "next_step": "Review the candidate, then use an explicit normal non-force push to the approved public remote.",
    }


def build_candidate(plan_path: Path, destination: Path) -> dict[str, Any]:
    plan = load_rewrite_plan(plan_path)
    source = Path(plan["source_repository"]).expanduser().resolve()
    destination = destination.expanduser().resolve()
    if destination.exists():
        raise ValueError("candidate destination already exists; refusing to overwrite it")
    if not destination.parent.is_dir():
        raise ValueError("candidate parent directory does not exist")
    if ".git" in destination.parts:
        raise ValueError("candidate destination must not be inside Git metadata")
    if destination == source or source in destination.parents:
        raise ValueError("candidate destination must be outside the source repository")
    assert_clean_source(source)
    current_head_code, current_head, head_error = git(source, "rev-parse", "HEAD")
    if current_head_code != 0 or current_head.strip() != plan.get("source_head"):
        raise ValueError(head_error or "source HEAD changed after the rewrite plan was created")
    if source_refs(source) != plan.get("source_refs"):
        raise ValueError("source refs changed after the rewrite plan was created")
    filter_repo = shutil.which("git-filter-repo")
    if not filter_repo:
        raise ValueError("git-filter-repo is required (install it with Homebrew)")
    filter_entrypoint = Path(filter_repo)
    if filter_entrypoint.parent not in {Path("/usr/local/bin"), Path("/opt/homebrew/bin")}:
        raise ValueError("git-filter-repo must be installed in a Homebrew binary directory")

    cloned = run_process([
        APPLE_GIT, "clone", "--mirror", "--no-local", "--", str(source), str(destination)
    ])
    if cloned.returncode != 0:
        raise ValueError(f"candidate clone failed; preserved partial destination: {cloned.stderr.strip()}")
    disconnected = run_process([
        APPLE_GIT, "--git-dir", str(destination), "remote", "remove", "origin"
    ])
    if disconnected.returncode != 0:
        raise ValueError("candidate could not be disconnected; preserved for inspection")
    filter_args = [filter_repo, "--force"]
    for path in plan["remove_paths"]:
        filter_args.extend(["--path", validate_removal_path(path)])
    filter_args.append("--invert-paths")
    rewritten = run_process(filter_args, timeout=900, cwd=destination)
    if rewritten.returncode != 0:
        raise ValueError("candidate rewrite failed; preserved candidate for inspection")

    candidate_objects = run_process([
        APPLE_GIT, "--git-dir", str(destination), "rev-list", "--objects", "--all"
    ])
    if candidate_objects.returncode != 0:
        raise ValueError("could not verify candidate history")
    object_paths = {
        line.partition(" ")[2]
        for line in candidate_objects.stdout.splitlines()
        if line.partition(" ")[1]
    }
    removed_absent = all(
        not any(item == path or item.startswith(path.rstrip("/") + "/") for item in object_paths)
        for path in plan["remove_paths"]
    )
    checked = run_process([APPLE_GIT, "--git-dir", str(destination), "fsck", "--full"])
    candidate_remotes = run_process([
        APPLE_GIT, "--git-dir", str(destination), "remote"
    ])
    source_unchanged = (
        git(source, "rev-parse", "HEAD")[1].strip() == plan["source_head"]
        and source_refs(source) == plan["source_refs"]
    )
    verification = {
        "source_unchanged": source_unchanged,
        "removed_paths_absent": removed_absent,
        "candidate_fsck_passed": checked.returncode == 0,
        "candidate_has_no_remotes": (
            candidate_remotes.returncode == 0 and not candidate_remotes.stdout.strip()
        ),
    }
    if not all(verification.values()):
        raise ValueError("candidate verification failed; candidate preserved for inspection")
    return {
        "mode": "candidate-only-history-rewrite",
        "source_repository": str(source),
        "candidate_repository": str(destination),
        "remove_path_count": len(plan["remove_paths"]),
        "verification": verification,
        "next_step": "Inspect and compare the candidate. No remote was changed.",
    }


def render(report: dict[str, Any]) -> str:
    lines = ["Warrior History: read-only assessment", f"repository  {report['repository']}"]
    lines.append(f"HEAD        {report['branch'] or '(detached)'} {report['head'] or '(unknown)'}")
    lines.append(
        f"history     {report['reachable_commit_count']} reachable commit(s), "
        f"{len(report['root_commits'])} root(s)"
    )
    if len(report["root_commits"]) > 1:
        for root in report["root_commits"]:
            lines.append(f"  root {root['commit'][:12]}  {root['subject']}")
    for warning in report["warnings"]:
        lines.append(f"WARNING     {warning}")
    if not report["artifacts"]:
        lines.append("artifacts   none with recognised database/archive/install-image suffixes")
    else:
        lines.append(f"artifacts   {len(report['artifacts'])} review candidate(s)")
        for item in report["artifacts"]:
            path = item.get("path", "[sensitive path withheld]")
            lines.append(f"  {item['presence']:12} {item['kind']:10} {path}")
    lines.append(
        f"large blobs {len(report['large_blobs'])} at or above "
        f"{report['large_blob_threshold_bytes']} bytes"
    )
    for item in report["large_blobs"]:
        path = item.get("path", "[sensitive path withheld]")
        lines.append(f"  {item['presence']:12} {item['size_bytes']:10} B {path}")
    lines.append(f"unreachable {len(report['unreachable_commits'])} commit(s), preserve and review")
    for item in report["unreachable_commits"][:12]:
        lines.append(f"  {item['commit'][:12]}  {item['subject']}")
    if len(report["unreachable_commits"]) > 12:
        lines.append(f"  ... {len(report['unreachable_commits']) - 12} more in JSON output")
    if report["guidance"]:
        lines.append("guidance")
        lines.extend(f"  - {item}" for item in report["guidance"])
    lines.append("Nothing was changed. A reported artifact may be intentional.")
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    assess_parser = subparsers.add_parser("assess", help="inspect reachable history")
    assess_parser.add_argument("repository", type=Path)
    assess_parser.add_argument("--json", action="store_true")
    assess_parser.add_argument(
        "--large-mb", type=float, default=10.0,
        help="large-blob threshold in MiB (default: 10)",
    )
    assess_parser.add_argument("--large-bytes", type=int, help=argparse.SUPPRESS)
    public_audit_parser = subparsers.add_parser(
        "public-audit", help="fail closed on secrets or personal data in one selected branch"
    )
    public_audit_parser.add_argument("repository", type=Path)
    public_audit_parser.add_argument("--ref", required=True)
    public_audit_parser.add_argument("--allow-email", action="append", default=[])
    public_audit_parser.add_argument("--json", action="store_true")
    plan_parser = subparsers.add_parser("plan", help="write an exact candidate rewrite plan")
    plan_parser.add_argument("repository", type=Path)
    plan_parser.add_argument("--remove-path", action="append", default=[])
    plan_parser.add_argument("--output", type=Path, required=True)
    plan_parser.add_argument("--json", action="store_true")
    public_plan_parser = subparsers.add_parser(
        "public-plan", help="write a source-pinned plan for a single-branch public projection"
    )
    public_plan_parser.add_argument("repository", type=Path)
    public_plan_parser.add_argument("--ref", required=True)
    public_plan_parser.add_argument("--public-name", required=True)
    public_plan_parser.add_argument("--public-email", required=True)
    attribution_group = public_plan_parser.add_mutually_exclusive_group(required=True)
    attribution_group.add_argument(
        "--sole-author", action="store_true",
        help="attribute every commit to the public owner and strip co-author trailers",
    )
    attribution_group.add_argument(
        "--retain-coauthors", action="store_true",
        help="attribute commits to the public owner but retain explicit co-author trailers",
    )
    public_plan_parser.add_argument("--remove-path", action="append", default=[])
    public_plan_parser.add_argument("--replace-text", type=Path)
    public_plan_parser.add_argument("--output", type=Path, required=True)
    public_plan_parser.add_argument("--json", action="store_true")
    build_parser = subparsers.add_parser(
        "build-candidate", help="rewrite a new bare candidate; never the source"
    )
    build_parser.add_argument("--plan", type=Path, required=True)
    build_parser.add_argument("--destination", type=Path, required=True)
    build_parser.add_argument("--json", action="store_true")
    public_build_parser = subparsers.add_parser(
        "build-public-candidate", help="build and fail-closed audit a single-branch public candidate"
    )
    public_build_parser.add_argument("--plan", type=Path, required=True)
    public_build_parser.add_argument("--destination", type=Path, required=True)
    public_build_parser.add_argument("--json", action="store_true")
    arguments = parser.parse_args()
    try:
        if arguments.command == "assess":
            large_bytes = (
                arguments.large_bytes
                if arguments.large_bytes is not None
                else int(arguments.large_mb * 1024 * 1024)
            )
            if large_bytes < 0:
                raise ValueError("the large-blob threshold must be zero or greater")
            report = assess(arguments.repository.expanduser().resolve(), large_bytes)
            text_output = render(report)
        elif arguments.command == "public-audit":
            report = public_audit(
                arguments.repository, arguments.ref, arguments.allow_email
            )
            text_output = (
                "Public history audit passed."
                if report["safe_for_publication"]
                else "Public history audit blocked publication; inspect the JSON report."
            )
        elif arguments.command == "public-plan":
            report = create_public_plan(
                arguments.repository, arguments.ref, arguments.public_name,
                arguments.public_email,
                "strip" if arguments.sole_author else "retain",
                arguments.remove_path,
                arguments.replace_text, arguments.output,
            )
            text_output = f"Public projection plan written to {arguments.output}. Source was not changed."
        elif arguments.command == "plan":
            report = create_rewrite_plan(
                arguments.repository, arguments.remove_path, arguments.output
            )
            text_output = f"Rewrite plan written to {arguments.output}. Source was not changed."
        elif arguments.command == "build-candidate":
            report = build_candidate(arguments.plan, arguments.destination)
            text_output = (
                f"Verified candidate written to {report['candidate_repository']}. "
                "Source and remotes were not changed."
            )
        else:
            report = build_public_candidate(arguments.plan, arguments.destination)
            text_output = (
                f"Verified public candidate written to {report['candidate_repository']}. "
                "Source and remotes were not changed."
            )
    except ValueError as error:
        print(f"warrior-history: {error}", file=sys.stderr)
        return 2
    print(json.dumps(report, indent=2, sort_keys=True) if arguments.json else text_output)
    if arguments.command == "public-audit" and not report["safe_for_publication"]:
        return 3
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
