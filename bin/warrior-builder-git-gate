#!/usr/bin/env python3
"""Kiro CLI preToolUse hook: enforce Warrior Builder's git authority.

Reads a single Kiro hook JSON payload from stdin (`hook_event_name`, `cwd`,
`session_id`, `tool_name`, `tool_input`). Exits 0 to allow the tool call, 2
(with a message on stderr) to reject it - same contract as
`warrior-builder-lease-gate`, which this pairs with. See
lib/warrior_builder_git_gate.py for the reasoning and what's categorical
versus lease-granted.

Wire it in as a preToolUse entry matching the shell tool:
    "hooks": {
        "preToolUse": [
            {"matcher": "shell", "command": "warrior-builder-git-gate", ...}
        ]
    }
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

LIB = Path(__file__).resolve().parent.parent / "lib"
if str(LIB) not in sys.path:
    sys.path.insert(0, str(LIB))

from warrior_builder_git_gate import evaluate  # noqa: E402


def main() -> int:
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except ValueError:
        return 0
    if not isinstance(payload, dict):
        return 0

    exit_code, message = evaluate(payload)
    if message:
        print(message, file=sys.stderr)
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
