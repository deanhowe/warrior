#!/usr/bin/env python3
"""Health report and fast-forward-only publisher for a Git-backed AI knowledge source.

This is deliberately forge- and harness-neutral: it never enables a native
unit, builds embeddings, or trusts an index, and `--publish` never force-
pushes or rewrites anything - it refuses whenever the remote head is not an
ancestor of local HEAD. It does not know whether your fork's native
Knowledge/Wiki/Goals-style unit is enabled, because that check is inherently
fork-specific (see docs/engineering/extending-gitea-native-units.md, and
moof-knowledge's own native_enabled() for a worked, Gitea-SQLite-specific
example of that half). Run this tool first; wire in your own fork's
unit-enabled check on top of it if you need one.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any

_LIB = Path(__file__).resolve().parent.parent / "lib"
if str(_LIB) not in sys.path:
    sys.path.insert(0, str(_LIB))
from warrior_forge import git, parse_ls_remote, redact_url_userinfo  # noqa: E402


def remote_default_branch(repo: Path, remote: str) -> tuple[str | None, str | None]:
    code, output, error = git(repo, "ls-remote", "--symref", remote, "HEAD")
    if code != 0:
        return None, error or "remote HEAD lookup failed"
    for line in output.splitlines():
        fields = line.split()
        if len(fields) == 3 and fields[0] == "ref:" and fields[2] == "HEAD":
            prefix = "refs/heads/"
            return (fields[1][len(prefix):] if fields[1].startswith(prefix)
                    else fields[1]), None
    return None, "remote does not advertise a symbolic HEAD"


def inspect(source: Path, remote: str) -> dict[str, Any]:
    errors: list[str] = []
    if not source.is_dir():
        return {"source": str(source), "healthy": False,
                "errors": ["knowledge source directory does not exist"]}

    code, inside, error = git(source, "rev-parse", "--is-inside-work-tree")
    if code != 0 or inside != "true":
        return {"source": str(source), "healthy": False,
                "errors": [error or "knowledge source is not a Git working tree"]}

    _, branch, _ = git(source, "branch", "--show-current")
    _, head, _ = git(source, "rev-parse", "HEAD")
    _, dirty, _ = git(source, "status", "--porcelain=v1")
    url_code, remote_url, remote_error = git(source, "remote", "get-url", remote)
    if url_code != 0:
        errors.append(remote_error or f"remote {remote!r} is missing")
        remote_url = ""

    default_branch, default_error = remote_default_branch(source, remote)
    if default_error:
        errors.append(default_error)

    remote_head = None
    if default_branch:
        code, refs, lookup_error = git(
            source, "ls-remote", remote, f"refs/heads/{default_branch}")
        if code != 0:
            errors.append(lookup_error or "remote default branch lookup failed")
        else:
            remote_head = parse_ls_remote(refs).get(f"refs/heads/{default_branch}")

    if not branch:
        errors.append("knowledge source has detached HEAD")
    if dirty:
        errors.append("knowledge source has uncommitted content")
    if default_branch and branch != default_branch:
        errors.append("local branch differs from remote symbolic HEAD")
    if remote_head and head != remote_head:
        errors.append("local HEAD differs from remote default branch")

    return {
        "source": str(source),
        "healthy": not errors,
        "branch": branch or None,
        "head": head or None,
        "dirty_entries": len(dirty.splitlines()) if dirty else 0,
        "remote": remote,
        "remote_url": redact_url_userinfo(remote_url),
        "remote_default_branch": default_branch,
        "remote_head": remote_head,
        "errors": errors,
    }


def _is_ancestor(repo: Path, ancestor: str, of_ref: str = "HEAD") -> bool | None:
    """True if `ancestor` is reachable from `of_ref` (a safe fast-forward).

    Uses `rev-list` rather than `merge-base --is-ancestor` because the latter
    is not on Warrior's git allowlist (assert_safe_git) - deliberately kept
    that way rather than widening a shared safety module for one caller.
    Returns None if the check itself could not be performed.
    """
    code, out, _ = git(repo, "rev-list", of_ref)
    if code != 0:
        return None
    return ancestor in out.splitlines()


def publish(source: Path, remote: str, branch: str | None = None) -> dict[str, Any]:
    """Push local knowledge to `remote`, fast-forward only, then re-verify.

    Deliberately does not touch anything fork-specific (no DB lookups, no
    "is the native unit enabled" check - see docs/engineering/
    extending-gitea-native-units.md and moof-knowledge's own native_enabled()
    for that worked example, which cannot be generalised without assuming a
    specific fork's schema).
    """
    report = inspect(source, remote)
    allowed_before_publish = {"local HEAD differs from remote default branch"}
    blocking = [error for error in report["errors"] if error not in allowed_before_publish]
    if blocking:
        return {"ok": False, "action": "refused", "errors": blocking}

    target_branch = branch or report.get("branch") or report.get("remote_default_branch")
    if not target_branch:
        return {"ok": False, "action": "refused", "errors": ["cannot determine which branch to publish"]}

    head = report.get("head")
    remote_head = report.get("remote_head")
    if remote_head and head and remote_head == head:
        return {"ok": True, "action": "already_published", "head": head}

    if remote_head:
        ancestor_ok = _is_ancestor(source, remote_head)
        if ancestor_ok is None:
            return {"ok": False, "action": "refused", "errors": ["could not verify remote head is an ancestor of local HEAD"]}
        if not ancestor_ok:
            return {"ok": False, "action": "refused", "errors": ["remote head is not an ancestor of local HEAD - not a fast-forward, refusing to push"]}

    code, _, err = git(source, "push", remote, target_branch)
    if code != 0:
        return {"ok": False, "action": "push_failed", "errors": [err.strip()]}

    after = inspect(source, remote)
    return {"ok": after["healthy"], "action": "published", "report": after}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path, help="Git-backed knowledge source")
    parser.add_argument("--remote", default="origin")
    parser.add_argument("--publish", action="store_true", help="push if healthy and fast-forward-only; otherwise only inspect")
    parser.add_argument("--branch", help="branch to publish (default: current branch, or remote's)")
    parser.add_argument("--json", action="store_true")
    arguments = parser.parse_args()
    source = arguments.source.expanduser().resolve()

    if arguments.publish:
        result = publish(source, arguments.remote, arguments.branch)
        if arguments.json:
            print(json.dumps(result, indent=2, sort_keys=True))
        else:
            print("Warrior Knowledge publish: " + result["action"])
            for error in result.get("errors", []):
                print(f"  - {error}")
            if result.get("head"):
                print(f"  head: {result['head']}")
        return 0 if result.get("ok") else 1

    report = inspect(source, arguments.remote)
    if arguments.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print("Warrior Knowledge: " + ("healthy" if report["healthy"] else "attention required"))
        for error in report["errors"]:
            print(f"  - {error}")
    return 0 if report["healthy"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
