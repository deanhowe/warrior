#!/usr/bin/env python3
"""Build a read-only Laravel/PHP evidence dossier."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

LIB = Path(__file__).resolve().parent.parent / "lib"
if str(LIB) not in sys.path:
    sys.path.insert(0, str(LIB))

from warrior_laravel import build_dossier  # noqa: E402


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="warrior-laravel")
    subparsers = parser.add_subparsers(dest="command", required=True)
    dossier = subparsers.add_parser("dossier", help="build a read-only Laravel/PHP dossier")
    dossier.add_argument("roots", nargs="+", type=Path)
    dossier.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    return parser


def _human(report: dict[str, object]) -> str:
    lines = ["WARRIOR LARAVEL DOSSIER — read-only"]
    for project in report["projects"]:  # type: ignore[index]
        lines.append(f"\n{project['path']} [{project['kind']}]")  # type: ignore[index]
        composer = project.get("composer")  # type: ignore[union-attr]
        if composer:
            lines.append(f"  Composer: {composer.get('name') or '(unnamed)'}")
        signals = project["signals"]  # type: ignore[index]
        active = ", ".join(name for name, present in signals.items() if present)
        lines.append(f"  Signals: {active or '(none)'}")
        boundaries = project["boundaries"]  # type: ignore[index]
        protected = [name for name, present in boundaries.items() if present and name.endswith("present")]
        lines.append(f"  Protected boundaries: {', '.join(protected) or '(none observed)'}")
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        report = build_dossier(args.roots)
    except ValueError as error:
        print(f"warrior-laravel: {error}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(_human(report))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
