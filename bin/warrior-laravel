#!/usr/bin/env python3
"""Build a read-only Laravel/PHP evidence dossier."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

LIB = Path(__file__).resolve().parent.parent / "lib"
if str(LIB) not in sys.path:
    sys.path.insert(0, str(LIB))

from warrior_laravel import build_dossier  # noqa: E402
from warrior_laravel_doctor import diagnose  # noqa: E402
from warrior_laravel_eval import DEFAULT_HOST, DEFAULT_MODEL, PROFILES, evaluate, human  # noqa: E402


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="warrior-laravel")
    subparsers = parser.add_subparsers(dest="command", required=True)
    dossier = subparsers.add_parser("dossier", help="build a read-only Laravel/PHP dossier")
    dossier.add_argument("roots", nargs="+", type=Path)
    dossier.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    doctor = subparsers.add_parser(
        "doctor",
        help="check a fresh clone for the DB-connection-drift / Vite-manifest / "
             "multitenancy-grant gaps that break tests without touching app code",
    )
    doctor.add_argument("root", type=Path)
    doctor.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    evaluation = subparsers.add_parser("eval", help="run bounded, local-only Laravel model checks")
    evaluation.add_argument("--model", default=DEFAULT_MODEL)
    evaluation.add_argument("--host", default=DEFAULT_HOST)
    evaluation.add_argument("--max-tasks", type=int, default=None)
    evaluation.add_argument("--timeout", type=float, default=120.0)
    evaluation.add_argument("--profile", choices=sorted(PROFILES), default="compact", help="bounded answer budget (default: compact)")
    evaluation.add_argument("--max-tokens", type=int, default=None, help="override the selected profile's output budget")
    evaluation.add_argument("--context-tokens", type=int, default=None, help="override the selected profile's context budget")
    evaluation.add_argument("--allow-network", action="store_true", help="permit an explicitly chosen non-loopback host")
    evaluation.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    return parser


def _human(report: dict[str, object]) -> str:
    lines = ["WARRIOR LARAVEL DOSSIER — read-only"]
    for project in report["projects"]:  # type: ignore[index]
        lines.append(f"\n{project['path']} [{project['kind']}]")  # type: ignore[index]
        composer = project.get("composer")  # type: ignore[union-attr]
        if composer:
            lines.append(f"  Composer: {composer.get('name') or '(unnamed)'}")
        signals = project["signals"]  # type: ignore[index]
        active = ", ".join(name for name, present in signals.items() if present)
        lines.append(f"  Signals: {active or '(none)'}")
        boundaries = project["boundaries"]  # type: ignore[index]
        protected = [name for name, present in boundaries.items() if present and name.endswith("present")]
        lines.append(f"  Protected boundaries: {', '.join(protected) or '(none observed)'}")
    return "\n".join(lines)


def _human_doctor(report: dict[str, object]) -> str:
    findings = report["findings"]  # type: ignore[index]
    if not findings:
        return f"WARRIOR LARAVEL DOCTOR — {report['root']}\nNo issues found."
    lines = [f"WARRIOR LARAVEL DOCTOR — {report['root']}"]
    for finding in findings:  # type: ignore[union-attr]
        lines.append(f"\n[{finding['severity'].upper()}] {finding['check']}")
        lines.append(f"  {finding['message']}")
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    if args.command == "eval":
        try:
            report = evaluate(
                model=args.model,
                host=args.host,
                max_tasks=args.max_tasks,
                timeout=args.timeout,
                profile=args.profile,
                max_tokens=args.max_tokens,
                context_tokens=args.context_tokens,
                allow_network=args.allow_network,
            )
        except (RuntimeError, ValueError) as error:
            print(f"warrior-laravel eval: {error}", file=sys.stderr)
            return 2
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print(human(report))
        return 0 if report["summary"]["passed"] == report["summary"]["total"] else 1
    if args.command == "doctor":
        report = diagnose(args.root)
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print(_human_doctor(report))
        return 1 if any(f["severity"] == "warning" for f in report["findings"]) else 0
    try:
        report = build_dossier(args.roots)
    except ValueError as error:
        print(f"warrior-laravel: {error}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(_human(report))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
