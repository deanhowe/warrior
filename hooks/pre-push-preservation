#!/bin/bash
# Block ref deletion, tag replacement, and non-fast-forward branch updates.
# Git supplies the real local/remote ref state on stdin; hook arguments are
# only the remote name and URL and must never be substring-matched for "-f".

set -u

is_zero() {
    case "$1" in
        *[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if is_zero "$local_sha"; then
        printf 'Warrior: refusing deletion of %s\n' "$remote_ref" >&2
        blocked=1
        continue
    fi
    if is_zero "$remote_sha"; then
        continue
    fi
    case "$remote_ref" in
        refs/tags/*)
            if [ "$local_sha" != "$remote_sha" ]; then
                printf 'Warrior: refusing replacement of existing tag %s\n' "$remote_ref" >&2
                blocked=1
            fi
            ;;
        refs/heads/*)
            if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
                printf 'Warrior: refusing non-fast-forward update of %s\n' "$remote_ref" >&2
                blocked=1
            fi
            ;;
        *)
            if [ "$local_sha" != "$remote_sha" ]; then
                printf 'Warrior: refusing replacement of %s\n' "$remote_ref" >&2
                blocked=1
            fi
            ;;
    esac
done

exit "$blocked"
